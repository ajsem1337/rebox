+static void d3d12_command_list_rebox_set_heaps(struct d3d12_command_list *list,
+        UINT heap_count, ID3D12DescriptorHeap *const *heaps)
+{
+    typedef HRESULT (*PFN_shadow_heap)(SIZE_T cpu, UINT64 *title_va, void **data, UINT *stride, UINT *count);
+    static PFN_shadow_heap shadow_heap;
+    static bool resolved;
+    vkd3d_module_t module;
+    unsigned int i, t;
+    UINT64 title;
+
+    if (!resolved)
+    {
+        if ((module = vkd3d_dlopen("d3d12_xs.dll")))
+            shadow_heap = (PFN_shadow_heap)vkd3d_dlsym(module, "ReboxShadowHeap");
+        resolved = true;
+    }
+    for (i = 0; i < heap_count; i++)
+    {
+        struct d3d12_descriptor_heap *heap = impl_from_ID3D12DescriptorHeap(heaps[i]);
+
+        if (!heap || (heap->desc.Type != D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV
+                && heap->desc.Type != D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER))
+            continue;
+        t = heap->desc.Type == D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER;
+        list->rebox.heap_cpu[t] = heap->cpu_va.ptr;
+        title = 0;
+        if (shadow_heap && FAILED(shadow_heap(heap->cpu_va.ptr, &title, NULL, NULL, NULL)))
+            title = 0;
+        list->rebox.title_base[t] = title;
+    }
+}
