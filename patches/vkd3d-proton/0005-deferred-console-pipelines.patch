+/* Where each AnyPS5 DescriptorKind lives among the bindless sets: uniform buffer, storage buffer,
+ * uniform and storage texel buffer, sampled and storage image, sampler. */
+void vkd3d_rebox_bindless_targets(struct d3d12_device *device, uint32_t targets[7][2])
+{
+    static const uint32_t want[7] =
+    {
+        VKD3D_BINDLESS_SET_CBV,
+        VKD3D_BINDLESS_SET_RAW_SSBO,
+        VKD3D_BINDLESS_SET_SRV | VKD3D_BINDLESS_SET_BUFFER,
+        VKD3D_BINDLESS_SET_UAV | VKD3D_BINDLESS_SET_BUFFER,
+        VKD3D_BINDLESS_SET_SRV | VKD3D_BINDLESS_SET_IMAGE,
+        VKD3D_BINDLESS_SET_UAV | VKD3D_BINDLESS_SET_IMAGE,
+        VKD3D_BINDLESS_SET_SAMPLER,
+    };
+    const struct vkd3d_bindless_state *bindless = &device->bindless_state;
+    unsigned int k, j;
+
+    for (k = 0; k < 7; k++)
+    {
+        targets[k][0] = ~0u;
+        targets[k][1] = 0;
+        for (j = 0; j < bindless->set_count; j++)
+        {
+            const struct vkd3d_bindless_set_info *info = &bindless->set_info[j];
+            /* As vkd3d_bindless_state_find_binding: shaders see bindless set j as Vulkan set j. */
+            if ((info->flags & want[k]) != want[k])
+                continue;
+            targets[k][0] = j;
+            targets[k][1] = info->binding_index;
+            break;
+        }
+    }
+}
