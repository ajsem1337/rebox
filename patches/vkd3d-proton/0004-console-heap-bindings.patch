+/* Console shaders name the bindless heaps by contract: descriptor set 0,
+ * binding 0 for the CBV/SRV/UAV heap (any number of differently typed
+ * variables may alias it, as with mutable descriptors) and binding 1 for the
+ * sampler heap. Point them at this device's real sets and bindings. */
+static void vkd3d_rebox_remap_heap_bindings(struct d3d12_device *device, uint32_t *words, size_t count)
+{
+    const struct vkd3d_bindless_state *bindless = &device->bindless_state;
+    uint32_t resource_set = ~0u, resource_binding = 0, sampler_set = ~0u, sampler_binding = 0;
+    uint32_t *set_word, *binding_word;
+    size_t i, j, len;
+
+    for (j = 0; j < bindless->set_count; j++)
+    {
+        const struct vkd3d_bindless_set_info *info = &bindless->set_info[j];
+        if (info->heap_type == D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER && sampler_set == ~0u)
+        {
+            sampler_set = j;
+            sampler_binding = info->binding_index;
+        }
+        else if (info->heap_type == D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV && resource_set == ~0u
+                && (info->flags & VKD3D_BINDLESS_SET_IMAGE))
+        {
+            resource_set = j;
+            resource_binding = info->binding_index;
+        }
+    }
+
+    /* For every decorated variable, find its DescriptorSet and Binding words. */
+    for (i = 5; i < count; i += len)
+    {
+        uint32_t target, set = ~0u, binding = ~0u;
+
+        if (!(len = words[i] >> 16))
+            return;
+        if ((words[i] & 0xffff) != 71 /* OpDecorate */ || len < 4 || words[i + 2] != 34 /* DescriptorSet */)
+            continue;
+        target = words[i + 1];
+        set_word = &words[i + 3];
+        set = *set_word;
+        binding_word = NULL;
+        for (size_t k = 5, kl; k < count; k += kl)
+        {
+            if (!(kl = words[k] >> 16))
+                break;
+            if ((words[k] & 0xffff) == 71 && kl >= 4 && words[k + 1] == target && words[k + 2] == 33 /* Binding */)
+            {
+                binding_word = &words[k + 3];
+                binding = *binding_word;
+                break;
+            }
+        }
+        if (set != 0 || !binding_word || binding > 1)
+            continue;
+        if (binding == 0 && resource_set != ~0u)
+        {
+            *set_word = resource_set;
+            *binding_word = resource_binding;
+        }
+        else if (binding == 1 && sampler_set != ~0u)
+        {
+            *set_word = sampler_set;
+            *binding_word = sampler_binding;
+        }
+        else
+            WARN("rebox: no bindless set for console heap binding %u.\n", binding);
+    }
+}
