+static VkPipeline d3d12_pipeline_state_rebox_create_compute(struct d3d12_pipeline_state *state,
+        const uint32_t *spirv, uint32_t spirv_words, uint32_t subgroup_size)
 {
     struct d3d12_device *device = state->device;
     const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
@@ -3405,21 +3405,13 @@ VkPipeline d3d12_pipeline_state_rebox_variant(struct d3d12_pipeline_state *state
     VkShaderModuleCreateInfo module_info;
     VkPipeline vk_pipeline = VK_NULL_HANDLE;
     VkShaderModule module;
-    size_t i;
