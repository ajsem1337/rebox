+        if (took > 50000000ull || !(n & (n - 1)))
+            ERR("rebox: console compute pipeline %u took %.1f ms (%u SPIR-V words); %.1f s in %u so far.\n", n,
+                    took / 1e6, spirv_words, total / 1e9, n);
