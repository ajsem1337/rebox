     if ((vr = VK_CALL(vkCreateShaderModule(device->vk_device, &module_info, NULL, &module))) < 0)
     {
         ERR("rebox: failed to create a console shader module, vr %d.\n", vr);
@@ -3436,43 +3428,234 @@ VkPipeline d3d12_pipeline_state_rebox_variant(struct d3d12_pipeline_state *state
     pipeline_info.basePipelineIndex = -1;
     if (d3d12_device_uses_descriptor_buffers(device))
         pipeline_info.flags |= VK_PIPELINE_CREATE_DESCRIPTOR_BUFFER_BIT_EXT;
-    if (out->subgroup_size && (device->device_info.vulkan_1_3_properties.requiredSubgroupSizeStages & VK_SHADER_STAGE_COMPUTE_BIT)
-            && out->subgroup_size >= device->device_info.vulkan_1_3_properties.minSubgroupSize
