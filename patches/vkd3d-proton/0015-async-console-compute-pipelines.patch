+
+/* Console compute pipelines are made by worker threads (REBOX_CONSOLE_ASYNC=0: at the dispatch):
+ * the driver's compile of a large module takes up to hundreds of milliseconds, and made in the
+ * title's recording threads, a scene's first hundreds of them stalled its frames until the title's
+ * GPU watchdog ended it. A variant being made is listed with no pipeline, and its dispatches are
+ * skipped, as while AnyPS5 compiles. */
+struct rebox_pipeline_job
+{
+    struct rebox_pipeline_job *next;
+    struct d3d12_pipeline_state *state;
+    const uint32_t *spirv; /* d3d12_xs's, valid for the process's lifetime */
+    uint32_t spirv_words, subgroup_size;
+    uint64_t key[2];
+};
+
+static struct
+{
+    pthread_mutex_t lock;
+    pthread_cond_t cond;
+    struct rebox_pipeline_job *head, **tail;
+    unsigned int threads;
+} rebox_pipeline_jobs = { .tail = &rebox_pipeline_jobs.head };
+static pthread_once_t rebox_pipeline_jobs_once = PTHREAD_ONCE_INIT;
+
+static void rebox_pipeline_jobs_init(void)
+{
+    pthread_mutex_init(&rebox_pipeline_jobs.lock, NULL);
+    pthread_cond_init(&rebox_pipeline_jobs.cond, NULL);
+}
+
+static void d3d12_pipeline_state_rebox_set_variant(struct d3d12_pipeline_state *state, const uint64_t key[2],
+        VkPipeline vk_pipeline)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &state->device->vk_procs;
+    size_t i;
 
     rwlock_lock_write(&state->lock);
     for (i = 0; i < state->rebox_variant_count; i++)
-        if (!memcmp(state->rebox_variants[i].key, out->key, sizeof(out->key)))
+        if (!memcmp(state->rebox_variants[i].key, key, sizeof(state->rebox_variants[i].key)))
             break;
-    if (i < state->rebox_variant_count)
+    if (i < state->rebox_variant_count && state->rebox_variants[i].vk_pipeline)
     {
         /* Another thread made it first. */
-        VK_CALL(vkDestroyPipeline(device->vk_device, vk_pipeline, NULL));
-        vk_pipeline = state->rebox_variants[i].vk_pipeline;
+        VK_CALL(vkDestroyPipeline(state->device->vk_device, vk_pipeline, NULL));
     }
+    else if (i < state->rebox_variant_count)
+        state->rebox_variants[i].vk_pipeline = vk_pipeline;
     else if (vkd3d_array_reserve((void **)&state->rebox_variants, &state->rebox_variant_capacity,
             state->rebox_variant_count + 1, sizeof(*state->rebox_variants)))
     {
-        memcpy(state->rebox_variants[state->rebox_variant_count].key, out->key, sizeof(out->key));
+        memcpy(state->rebox_variants[state->rebox_variant_count].key, key, sizeof(state->rebox_variants[0].key));
         state->rebox_variants[state->rebox_variant_count++].vk_pipeline = vk_pipeline;
     }
+    else
+        VK_CALL(vkDestroyPipeline(state->device->vk_device, vk_pipeline, NULL));
     rwlock_unlock_write(&state->lock);
+}
+
+static void *rebox_pipeline_worker(void *arg)
+{
+    struct rebox_pipeline_job *job;
+    VkPipeline vk_pipeline;
+
+    vkd3d_set_thread_name("rebox-pipelines");
+    for (;;)
+    {
+        pthread_mutex_lock(&rebox_pipeline_jobs.lock);
+        while (!rebox_pipeline_jobs.head)
+            pthread_cond_wait(&rebox_pipeline_jobs.cond, &rebox_pipeline_jobs.lock);
+        job = rebox_pipeline_jobs.head;
+        if (!(rebox_pipeline_jobs.head = job->next))
+            rebox_pipeline_jobs.tail = &rebox_pipeline_jobs.head;
+        pthread_mutex_unlock(&rebox_pipeline_jobs.lock);
+
+        /* A failed compile stays listed with no pipeline: its dispatches are skipped. */
+        if ((vk_pipeline = d3d12_pipeline_state_rebox_create_compute(job->state, job->spirv, job->spirv_words,
+                job->subgroup_size)))
+            d3d12_pipeline_state_rebox_set_variant(job->state, job->key, vk_pipeline);
+        d3d12_pipeline_state_dec_ref(job->state);
+        vkd3d_free(job);
+    }
+    return NULL;
+}
+
+static unsigned int rebox_cpu_count(void)
+{
+#ifdef _WIN32
+    SYSTEM_INFO info;
+    GetSystemInfo(&info);
+    return info.dwNumberOfProcessors;
+#else
+    long n = sysconf(_SC_NPROCESSORS_ONLN);
+    return n > 0 ? n : 1;
+#endif
+}
+
+static bool rebox_pipelines_async(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        char value[8];
+        on = !(vkd3d_get_env_var("REBOX_CONSOLE_ASYNC", value, sizeof(value)) && !strcmp(value, "0"));
+    }
+    return on;
+}
+
+static bool d3d12_pipeline_state_rebox_queue_variant(struct d3d12_pipeline_state *state,
+        const struct vkd3d_rebox_compile_out *out)
+{
+    struct rebox_pipeline_job *job;
+    unsigned int want;
+    pthread_t thread;
+
+    if (!(job = vkd3d_calloc(1, sizeof(*job))))
+        return false;
+    job->state = state;
+    job->spirv = out->spirv;
+    job->spirv_words = out->spirv_words;
+    job->subgroup_size = out->subgroup_size;
+    memcpy(job->key, out->key, sizeof(job->key));
+    d3d12_pipeline_state_inc_ref(state);
+
+    pthread_once(&rebox_pipeline_jobs_once, rebox_pipeline_jobs_init);
+    pthread_mutex_lock(&rebox_pipeline_jobs.lock);
+    *rebox_pipeline_jobs.tail = job;
+    rebox_pipeline_jobs.tail = &job->next;
+    /* Half the CPUs, at most 8, as d3d12_xs's AnyPS5 workers; REBOX_PIPELINE_THREADS sets it (a world's pipelines take GBs each to build). */
+    { char v[16]; want = vkd3d_get_env_var("REBOX_PIPELINE_THREADS", v, sizeof(v)) && atoi(v) > 0 ? atoi(v) : rebox_cpu_count() / 2; }
+    want = want < 1 ? 1 : want > 8 ? 8 : want;
+    while (rebox_pipeline_jobs.threads < want)
+    {
+        /* The workers run for the process's lifetime. */
+        if (pthread_create(&thread, NULL, rebox_pipeline_worker, NULL))
+            break;
+        rebox_pipeline_jobs.threads++;
+    }
+    pthread_cond_signal(&rebox_pipeline_jobs.cond);
+    pthread_mutex_unlock(&rebox_pipeline_jobs.lock);
+    return rebox_pipeline_jobs.threads != 0;
+}
+
+/* The pipeline for one compile of a deferred console shader: made on first use, by a worker thread
+ * unless REBOX_CONSOLE_ASYNC=0 (VK_NULL_HANDLE until it is ready). */
+VkPipeline d3d12_pipeline_state_rebox_variant(struct d3d12_pipeline_state *state,
+        const struct vkd3d_rebox_compile_out *out)
+{
+    VkPipeline vk_pipeline = VK_NULL_HANDLE;
+    bool listed = false;
+    size_t i;
+
+    rwlock_lock_read(&state->lock);
+    for (i = 0; i < state->rebox_variant_count; i++)
+        if (!memcmp(state->rebox_variants[i].key, out->key, sizeof(out->key)))
+        {
+            vk_pipeline = state->rebox_variants[i].vk_pipeline;
+            listed = true;
+        }
+    rwlock_unlock_read(&state->lock);
+    if (listed)
+        return vk_pipeline;
+
+    if (rebox_pipelines_async())
+    {
+        rwlock_lock_write(&state->lock);
+        for (i = 0; i < state->rebox_variant_count; i++)
+            if (!memcmp(state->rebox_variants[i].key, out->key, sizeof(out->key)))
+                break;
+        if (i < state->rebox_variant_count)
+        {
+            vk_pipeline = state->rebox_variants[i].vk_pipeline;
+            rwlock_unlock_write(&state->lock);
+            return vk_pipeline;
+        }
+        if (!vkd3d_array_reserve((void **)&state->rebox_variants, &state->rebox_variant_capacity,
+                state->rebox_variant_count + 1, sizeof(*state->rebox_variants)))
+        {
+            rwlock_unlock_write(&state->lock);
+            return VK_NULL_HANDLE;
+        }
+        memset(&state->rebox_variants[state->rebox_variant_count], 0, sizeof(state->rebox_variants[0]));
+        memcpy(state->rebox_variants[state->rebox_variant_count++].key, out->key, sizeof(out->key));
+        rwlock_unlock_write(&state->lock);
+        if (d3d12_pipeline_state_rebox_queue_variant(state, out))
+            return VK_NULL_HANDLE;
+        /* No worker: made here. */
+    }
+
+    if ((vk_pipeline = d3d12_pipeline_state_rebox_create_compute(state, out->spirv, out->spirv_words,
+            out->subgroup_size)))
+        d3d12_pipeline_state_rebox_set_variant(state, out->key, vk_pipeline);
+    rwlock_lock_read(&state->lock);
+    for (i = 0; i < state->rebox_variant_count; i++)
+        if (!memcmp(state->rebox_variants[i].key, out->key, sizeof(out->key)))
+            vk_pipeline = state->rebox_variants[i].vk_pipeline;
+    rwlock_unlock_read(&state->lock);
     return vk_pipeline;
 }
 
