+    start = vkd3d_get_current_time_ns();
     vr = VK_CALL(vkCreateComputePipelines(device->vk_device, VK_NULL_HANDLE, 1, &pipeline_info, NULL, &vk_pipeline));
+    took = vkd3d_get_current_time_ns() - start;
     VK_CALL(vkDestroyShaderModule(device->vk_device, module, NULL));
