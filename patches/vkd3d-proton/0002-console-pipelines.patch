+const struct vkd3d_rebox_console_shader *vkd3d_rebox_console_shader(const D3D12_SHADER_BYTECODE *code)
+{
+    const struct vkd3d_rebox_console_shader *h = code->pShaderBytecode;
+
+    if (!h || code->BytecodeLength < sizeof(*h) || h->magic != VKD3D_REBOX_CONSOLE_MAGIC || h->version != 1
+            || (h->spirv_offset & 3) || h->spirv_offset < sizeof(*h) || h->spirv_size < 20
+            || h->spirv_offset > code->BytecodeLength || h->spirv_size > code->BytecodeLength - h->spirv_offset
+            || (h->dxbc_size && (h->dxbc_offset > code->BytecodeLength
+                    || h->dxbc_size > code->BytecodeLength - h->dxbc_offset)))
+        return NULL;
+    return h;
+}
+
+struct vkd3d_shader_code vkd3d_rebox_shader_dxbc(const D3D12_SHADER_BYTECODE *code)
+{
+    const struct vkd3d_rebox_console_shader *h = vkd3d_rebox_console_shader(code);
+    struct vkd3d_shader_code dxbc;
+
+    memset(&dxbc, 0, sizeof(dxbc));
+    if (!h)
+    {
+        dxbc.code = code->pShaderBytecode;
+        dxbc.size = code->BytecodeLength;
+    }
+    else if (h->dxbc_size)
+    {
+        dxbc.code = (const uint8_t *)h + h->dxbc_offset;
+        dxbc.size = h->dxbc_size;
+    }
+    return dxbc;
+}
+
+/* The console shader's SPIR-V is used as is: no DXBC to convert. */
+static HRESULT vkd3d_rebox_load_console_shader(const struct vkd3d_rebox_console_shader *h,
+        struct vkd3d_shader_code *spirv_code)
+{
+    void *code;
+
+    if (!(code = vkd3d_malloc(h->spirv_size)))
+        return E_OUTOFMEMORY;
+    memcpy(code, (const uint8_t *)h + h->spirv_offset, h->spirv_size);
+    memset(spirv_code, 0, sizeof(*spirv_code));
+    spirv_code->code = code;
+    spirv_code->size = h->spirv_size;
+    spirv_code->meta.hash = vkd3d_shader_hash(spirv_code);
+    memcpy(spirv_code->meta.cs_workgroup_size, h->workgroup_size, sizeof(h->workgroup_size));
+    if (h->wave_size)
+    {
+        spirv_code->meta.flags |= VKD3D_SHADER_META_FLAG_USES_SUBGROUP_OPERATIONS;
+        spirv_code->meta.cs_wave_size_min = h->wave_size;
+        spirv_code->meta.cs_wave_size_max = h->wave_size;
+        spirv_code->meta.cs_wave_size_preferred = h->wave_size;
+    }
+    return S_OK;
+}
