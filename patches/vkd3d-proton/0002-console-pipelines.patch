+/* rebox: a console shader's user SGPRs. Default mapping (Leonida's,
+ * unmeasured): root parameters in order, one dword per 32-bit constant, two
+ * (a 64-bit GPU address) per root descriptor or descriptor table. Tables point
+ * at the real descriptor address in the bound heap (embedded mutable
+ * descriptors only; otherwise 0). heap_base and code_base stay 0. */
+static uint64_t d3d12_command_list_rebox_table_va(struct d3d12_command_list *list,
+        const struct vkd3d_shader_root_parameter *p, uint32_t index)
+{
+    struct vkd3d_bindless_state *bindless = &list->device->bindless_state;
+    D3D12_DESCRIPTOR_HEAP_TYPE type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+    VkDeviceAddress base;
+    unsigned int j;
+
+    if (!d3d12_device_use_embedded_mutable_descriptors(list->device))
+        return 0;
+    if (p->descriptor_table.binding_count && p->descriptor_table.first_binding->type == VKD3D_SHADER_DESCRIPTOR_TYPE_SAMPLER)
+        type = D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER;
+    base = type == D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER ? list->descriptor_heap.buffers.heap_va_sampler
+            : list->descriptor_heap.buffers.heap_va_resource;
+    if (!base)
+        return 0;
+    for (j = 0; j < bindless->set_count; j++)
+        if (bindless->set_info[j].heap_type == type)
+        {
+            base += list->descriptor_heap.buffers.vk_offsets[j];
+            break;
+        }
+    return base + (uint64_t)index * d3d12_device_get_descriptor_handle_increment_size(list->device, type);
+}
+
+static void d3d12_command_list_rebox_push(struct d3d12_command_list *list,
+        struct vkd3d_pipeline_bindings *bindings, const struct d3d12_bind_point_layout *layout)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    const struct d3d12_root_signature *rs = bindings->root_signature;
+    uint32_t data[VKD3D_REBOX_CONSOLE_PUSH_SIZE / sizeof(uint32_t)];
+    unsigned int i, k, n = 0;
+
+    memset(data, 0, sizeof(data));
+    for (i = 0; rs && i < rs->parameter_count && n < 32; i++)
+    {
+        const struct vkd3d_shader_root_parameter *p = &rs->parameters[i];
+        uint64_t va = 0;
+
+        switch (p->parameter_type)
+        {
+            case D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS:
+                for (k = 0; k < p->constant.constant_count && n < 32; k++)
+                    data[n++] = bindings->root_constants[p->constant.constant_index + k];
+                continue;
+            case D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE:
+                va = d3d12_command_list_rebox_table_va(list, p, bindings->descriptor_tables[i]);
+                break;
+            default:
+                if (rs->root_descriptor_raw_va_mask & (1ull << i))
+                    va = bindings->root_descriptors[i].info.va;
+                break;
+        }
+        data[n++] = (uint32_t)va;
+        if (n < 32)
+            data[n++] = (uint32_t)(va >> 32);
+    }
+
+    VK_CALL(vkCmdPushConstants(list->cmd.vk_command_buffer, layout->vk_pipeline_layout,
+            layout->vk_push_stages, 0, sizeof(data), data));
+    /* That overwrote vkd3d's own push data: have it pushed again next time. */
+    d3d12_command_list_invalidate_root_parameters(list, bindings, false, NULL);
+}
