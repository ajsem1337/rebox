 /* ID3D12PipelineState */
+/* rebox: translated console shaders (docs/shaders.md in
+ * rebox). The D3D12.X layer hands them over in place of DXBC as
+ * this header followed by SPIR-V. They get their user SGPRs from a push
+ * constant block packed at dispatch from the root parameters: s0-s31, then
+ * heap_base and code_base (both 64-bit). */
+#define VKD3D_REBOX_CONSOLE_MAGIC 0x56534353u /* "SCSV" */
+#define VKD3D_REBOX_CONSOLE_PUSH_SIZE 144u
+struct vkd3d_rebox_console_shader
+{
+    uint32_t magic;
+    uint32_t version;       /* 1 */
+    uint32_t stage;         /* VkShaderStageFlagBits */
+    uint32_t wave_size;     /* 0 (driver's choice), 32 or 64 */
+    uint32_t workgroup_size[3];
+    uint32_t spirv_offset;  /* from the start of the header, 4-aligned */
+    uint32_t spirv_size;
+    uint32_t dxbc_offset;   /* the original console DXBC container, for its I/O */
+    uint32_t dxbc_size;     /* signatures (graphics stages); 0 if absent */
+};
+const struct vkd3d_rebox_console_shader *vkd3d_rebox_console_shader(const D3D12_SHADER_BYTECODE *code);
+/* What signature parsing should read: the embedded DXBC of a console shader,
+ * or the bytecode itself. */
+struct vkd3d_shader_code vkd3d_rebox_shader_dxbc(const D3D12_SHADER_BYTECODE *code);
