@@ -3722,6 +3741,129 @@ const struct vkd3d_rebox_graphics *d3d12_pipeline_state_rebox_graphics(struct d3
  * state with the two modules and vertex input from the vertex stage's attributes. Attribute
  * location r reads input layout element r (the console's fetch fills input r in the element's
  * order). */
+/* What d3d12_pipeline_state_rebox_graphics_variant's pipeline is made from, kept so a worker thread
+ * can make it: the stages' SPIR-V is d3d12_xs's, valid for the process's lifetime. */
+struct rebox_graphics_build
+{
+    struct d3d12_pipeline_state *state;
+    struct vkd3d_pipeline_key pipeline_key;
+    const struct vkd3d_format *dsv_format;
+    struct vkd3d_rebox_graphics_override override;
+    VkVertexInputAttributeDescription attributes[D3D12_VS_INPUT_REGISTER_COUNT];
+    VkVertexInputBindingDescription bindings[D3D12_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT];
+    const uint32_t *spirv[4]; /* vertex (or mesh), pixel, rect-list control and evaluation */
+    uint32_t words[4];
+    bool rect;
+    uint64_t key[2];
+};
+
+/* Makes a console graphics pipeline and lists it as the PSO's variant (in place of a listing with
+ * no pipeline yet); returns it, or VK_NULL_HANDLE. */
+static VkPipeline rebox_graphics_build(const struct rebox_graphics_build *b, uint32_t *dynamic_state_flags)
+{
+    struct d3d12_pipeline_state *state = b->state;
+    struct d3d12_graphics_pipeline_state *graphics = &state->graphics;
+    struct d3d12_device *device = state->device;
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    struct vkd3d_rebox_graphics_override override = b->override;
+    struct vkd3d_pipeline_key pipeline_key = b->pipeline_key;
+    VkShaderModuleCreateInfo module_info;
+    VkPipeline vk_pipeline = VK_NULL_HANDLE;
+    size_t v;
+
+    override.attributes = b->attributes;
+    override.bindings = b->bindings;
+    memset(&module_info, 0, sizeof(module_info));
+    module_info.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+    module_info.codeSize = b->words[0] * sizeof(uint32_t);
+    module_info.pCode = b->spirv[0];
+    if (VK_CALL(vkCreateShaderModule(device->vk_device, &module_info, NULL, &override.vs)) < 0)
+        return VK_NULL_HANDLE;
+    module_info.codeSize = b->words[1] * sizeof(uint32_t);
+    module_info.pCode = b->spirv[1];
+    /* rebox (patch 0014): a depth-only pipeline has no pixel stage, and no fragment module. */
+    if (b->words[1] && VK_CALL(vkCreateShaderModule(device->vk_device, &module_info, NULL, &override.ps)) < 0)
+    {
+        VK_CALL(vkDestroyShaderModule(device->vk_device, override.vs, NULL));
+        return VK_NULL_HANDLE;
+    }
+    if (b->rect && graphics->stage_count + 2 <= VKD3D_MAX_SHADER_STAGES)
+    {
+        module_info.codeSize = b->words[2] * sizeof(uint32_t);
+        module_info.pCode = b->spirv[2];
+        if (VK_CALL(vkCreateShaderModule(device->vk_device, &module_info, NULL, &override.control)) < 0)
+            override.control = VK_NULL_HANDLE;
+        module_info.codeSize = b->words[3] * sizeof(uint32_t);
+        module_info.pCode = b->spirv[3];
+        if (override.control
+                && VK_CALL(vkCreateShaderModule(device->vk_device, &module_info, NULL, &override.evaluation)) < 0)
+            override.evaluation = VK_NULL_HANDLE;
+    }
+    if (b->rect && !override.evaluation)
+    {
+        if (override.control)
+            VK_CALL(vkDestroyShaderModule(device->vk_device, override.control, NULL));
+        VK_CALL(vkDestroyShaderModule(device->vk_device, override.vs, NULL));
+        VK_CALL(vkDestroyShaderModule(device->vk_device, override.ps, NULL));
+        return VK_NULL_HANDLE;
+    }
+
+    rebox_override = &override;
+    {
+        /* Pipeline creation for console stages: the driver compiles AnyPS5's (sometimes very large)
+         * modules here, outside every timer in d3d12_xs. */
+        static uint64_t total_ns;
+        static uint32_t count;
+        uint64_t start = vkd3d_get_current_time_ns(), took;
+        vk_pipeline = d3d12_pipeline_state_create_pipeline_variant(state, &pipeline_key, b->dsv_format, VK_NULL_HANDLE,
+                0, dynamic_state_flags);
+        took = vkd3d_get_current_time_ns() - start;
+        total_ns += took;
+        count++;
+        if (took > 50000000ull || !(count & (count - 1)))
+            ERR("rebox: console pipeline %u took %.1f ms (VS %u, PS %u SPIR-V words); %.1f s in %u so far.\n", count,
+                    took / 1e6, b->words[0], b->words[1], total_ns / 1e9, count);
+    }
+    rebox_override = NULL;
+    VK_CALL(vkDestroyShaderModule(device->vk_device, override.vs, NULL));
+    VK_CALL(vkDestroyShaderModule(device->vk_device, override.ps, NULL));
+    if (override.control)
+        VK_CALL(vkDestroyShaderModule(device->vk_device, override.control, NULL));
+    if (override.evaluation)
+        VK_CALL(vkDestroyShaderModule(device->vk_device, override.evaluation, NULL));
+    if (!vk_pipeline)
+    {
+        ERR("rebox: failed to create a console graphics pipeline.\n");
+        return VK_NULL_HANDLE;
+    }
+
+    rwlock_lock_write(&state->lock);
+    for (v = 0; v < state->rebox_variant_count; v++)
+        if (!memcmp(state->rebox_variants[v].key, b->key, sizeof(b->key)))
+            break;
+    if (v < state->rebox_variant_count && state->rebox_variants[v].vk_pipeline)
+    {
+        VK_CALL(vkDestroyPipeline(device->vk_device, vk_pipeline, NULL));
+        vk_pipeline = state->rebox_variants[v].vk_pipeline;
+        *dynamic_state_flags = state->rebox_variants[v].dynamic_state_flags;
+    }
+    else if (v < state->rebox_variant_count)
+    {
+        /* Listed while a worker made it. */
+        state->rebox_variants[v].vk_pipeline = vk_pipeline;
+        state->rebox_variants[v].dynamic_state_flags = *dynamic_state_flags;
+    }
+    else if (vkd3d_array_reserve((void **)&state->rebox_variants, &state->rebox_variant_capacity,
+            state->rebox_variant_count + 1, sizeof(*state->rebox_variants)))
+    {
+        memcpy(state->rebox_variants[state->rebox_variant_count].key, b->key, sizeof(b->key));
+        state->rebox_variants[state->rebox_variant_count].vk_pipeline = vk_pipeline;
+        state->rebox_variants[state->rebox_variant_count++].dynamic_state_flags = *dynamic_state_flags;
+    }
+    rwlock_unlock_write(&state->lock);
+    return vk_pipeline;
+}
