+/* Queues a job for the workers (holding a reference to its PSO); FALSE if no worker could start. */
+static bool rebox_pipeline_enqueue(struct rebox_pipeline_job *job)
+{
+    unsigned int want;
+    pthread_t thread;
 
+    d3d12_pipeline_state_inc_ref(job->state);
