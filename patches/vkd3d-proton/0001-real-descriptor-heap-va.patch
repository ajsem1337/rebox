+
+/* rebox: the real GPU address of a shader-visible heap's descriptors.
+ * Console shaders dereference descriptor table pointers, so the D3D12.X layer
+ * hands titles real heap addresses instead of the virtual handles above, and
+ * translates them back where D3D12 takes a GPU handle. Only meaningful with
+ * embedded mutable descriptors, where the CPU handle is the mapped descriptor
+ * buffer and the increment equals the descriptor stride. */
+HRESULT vkd3d_rebox_get_descriptor_heap_va(ID3D12DescriptorHeap *iface, uint64_t *gpu_va, UINT *stride)
+{
+    struct d3d12_descriptor_heap *heap;
+    size_t offset;
+
+    if (!iface || iface->lpVtbl != &d3d12_descriptor_heap_vtbl || !gpu_va || !stride)
+        return E_INVALIDARG;
+    heap = CONTAINING_RECORD(iface, struct d3d12_descriptor_heap, ID3D12DescriptorHeap_iface);
+    if (!(heap->desc.Flags & D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE) || !heap->descriptor_buffer.va
+            || !d3d12_device_use_embedded_mutable_descriptors(heap->device)
+            || (heap->desc.Type != D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV
+                    && heap->desc.Type != D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER))
+        return E_NOTIMPL;
+    offset = (const uint8_t *)heap->cpu_va.ptr - heap->descriptor_buffer.host_allocation;
+    *gpu_va = heap->descriptor_buffer.va + offset;
+    *stride = d3d12_device_get_descriptor_handle_increment_size(heap->device, heap->desc.Type);
+    return S_OK;
+}
