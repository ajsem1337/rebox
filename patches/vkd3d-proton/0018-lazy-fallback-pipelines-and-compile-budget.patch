+/* rebox (patch 0018): whether the PSO being created on this thread is one d3d12_xs gave fallback
+ * shaders (its ReboxFallbackPso). */
+static bool vkd3d_rebox_fallback_pso(void)
+{
+    typedef BOOL (WINAPI *PFN_fallback_pso)(void);
+    static PFN_fallback_pso fn;
+    static bool resolved;
+    vkd3d_module_t module;
+
+    if (!resolved)
+    {
+        if ((module = vkd3d_dlopen("d3d12_xs.dll")))
+            fn = (PFN_fallback_pso)vkd3d_dlsym(module, "ReboxFallbackPso");
+        resolved = true;
+    }
+    return fn && fn();
+}
+
+/* rebox (patch 0018): SPIR-V words of console pipelines being made at once. The driver's compile of
+ * a world's largest modules (1-2.4M words) holds GBs each, and several at once took the process's
+ * heap past 30 GB. A pipeline is made once the words in flight and its own fit in
+ * REBOX_PIPELINE_WORDS_IN_FLIGHT (default 1.5M; 0: no limit), or when nothing else is in flight;
+ * they are let in in the order they asked. */
+static struct
+{
+    pthread_mutex_t lock;
+    pthread_cond_t cond;
+    uint64_t in_flight, next_ticket, serving;
+    uint32_t limit;
+} rebox_words;
+static pthread_once_t rebox_words_once = PTHREAD_ONCE_INIT;
+
+static void rebox_words_init(void)
+{
+    char value[32];
+
+    pthread_mutex_init(&rebox_words.lock, NULL);
+    pthread_cond_init(&rebox_words.cond, NULL);
+    rebox_words.limit = 1500000;
+    if (vkd3d_get_env_var("REBOX_PIPELINE_WORDS_IN_FLIGHT", value, sizeof(value)))
+        rebox_words.limit = strtoul(value, NULL, 0);
+}
+
+static void rebox_words_acquire(uint32_t words)
+{
+    static uint32_t waits;
+    uint64_t ticket;
+    bool waited = false;
+
+    pthread_once(&rebox_words_once, rebox_words_init);
+    if (!rebox_words.limit)
+        return;
+    pthread_mutex_lock(&rebox_words.lock);
+    ticket = rebox_words.next_ticket++;
+    while (ticket != rebox_words.serving
+            || (rebox_words.in_flight && rebox_words.in_flight + words > rebox_words.limit))
+    {
+        waited = true;
+        pthread_cond_wait(&rebox_words.cond, &rebox_words.lock);
+    }
+    rebox_words.serving++;
+    rebox_words.in_flight += words;
+    pthread_cond_broadcast(&rebox_words.cond);
+    pthread_mutex_unlock(&rebox_words.lock);
+    if (waited)
+    {
+        uint32_t n = __atomic_add_fetch(&waits, 1, __ATOMIC_RELAXED);
+        if (!(n & (n - 1)))
+            ERR("rebox: %u console pipelines waited for SPIR-V words in flight (limit %u).\n", n, rebox_words.limit);
+    }
+}
+
+static void rebox_words_release(uint32_t words)
+{
+    if (!rebox_words.limit)
+        return;
+    pthread_mutex_lock(&rebox_words.lock);
+    rebox_words.in_flight -= words;
+    pthread_cond_broadcast(&rebox_words.cond);
+    pthread_mutex_unlock(&rebox_words.lock);
+}
+
+static bool rebox_variant_log(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        char value[8];
+        on = vkd3d_get_env_var("REBOX_VARIANT_LOG", value, sizeof(value)) && !strcmp(value, "1");
+    }
+    return on;
+}
