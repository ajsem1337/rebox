+
+/* rebox: where console shaders find this heap's descriptor lookup
+ * table; passed in their push block while the heap is bound. */
+HRESULT vkd3d_rebox_set_descriptor_heap_lookup(ID3D12DescriptorHeap *iface, uint64_t table_va)
+{
+    if (!iface || iface->lpVtbl != &d3d12_descriptor_heap_vtbl)
+        return E_INVALIDARG;
+    CONTAINING_RECORD(iface, struct d3d12_descriptor_heap, ID3D12DescriptorHeap_iface)->rebox_lookup_va = table_va;
+    return S_OK;
+}
