+/* rebox (patch 0006): set while d3d12_pipeline_state_rebox_graphics_variant builds a
+ * pipeline, so d3d12_pipeline_state_create_pipeline_variant uses console stages and vertex input
+ * in place of the PSO's own. */
+struct vkd3d_rebox_graphics_override
+{
+    VkShaderModule vs, ps;
+    const VkVertexInputAttributeDescription *attributes;
+    uint32_t attribute_count;
+    const VkVertexInputBindingDescription *bindings;
+    uint32_t binding_count;
+};
+static VKD3D_THREAD_LOCAL const struct vkd3d_rebox_graphics_override *rebox_override;
+
+/* {53435247-0001-4000-8000-736361726c74}: d3d12_xs's REBOX_GRAPHICS_GUID. */
+static const GUID vkd3d_rebox_graphics_guid =
+        {0x53435247, 0x0001, 0x4000, {0x80, 0x00, 0x73, 0x63, 0x61, 0x72, 0x6c, 0x74}};
+
+/* The PSO's deferred console graphics, read from its private data at the first draw. */
+const struct vkd3d_rebox_graphics *d3d12_pipeline_state_rebox_graphics(struct d3d12_pipeline_state *state)
+{
+    struct vkd3d_rebox_graphics *g;
+    unsigned int size = 0, i;
+
+    if (state->rebox_graphics_checked)
+        return state->rebox_graphics;
+    if (!d3d12_pipeline_state_is_graphics(state))
+        return NULL;
+    rwlock_lock_write(&state->lock);
+    if (!state->rebox_graphics_checked)
+    {
+        if (SUCCEEDED(vkd3d_get_private_data(&state->private_store, &vkd3d_rebox_graphics_guid, &size, NULL))
+                && size >= sizeof(*g) && (g = vkd3d_malloc(size)))
+        {
+            if (SUCCEEDED(vkd3d_get_private_data(&state->private_store, &vkd3d_rebox_graphics_guid, &size, g))
+                    && g->magic == VKD3D_REBOX_GRAPHICS_MAGIC && g->version == 1 && g->size == size
+                    && g->element_count <= ARRAY_SIZE(g->elements)
+                    && g->vs_offset <= size && g->vs_size <= size - g->vs_offset
+                    && g->ps_offset <= size && g->ps_size <= size - g->ps_offset)
+            {
+                state->rebox_graphics = g;
+                /* Push the console block (patch 0002) instead of root constants, and bind the
+                 * input layout's vertex buffers, which the fallback vertex shader doesn't read. */
+                state->rebox_console = true;
+                for (i = 0; i < g->element_count; i++)
+                    if (g->elements[i].slot < D3D12_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT)
+                        state->graphics.vertex_buffer_mask |= 1u << g->elements[i].slot;
+            }
+            else
+                vkd3d_free(g);
+        }
+        state->rebox_graphics_checked = true;
+    }
+    rwlock_unlock_write(&state->lock);
+    return state->rebox_graphics;
+}
+
+/* The pipeline for one compile of a PSO's deferred console stages, made on first use: the PSO's own
+ * state with the two modules and vertex input from the vertex stage's attributes. Attribute
+ * location r reads input layout element r (the console's fetch fills input r in the element's
+ * order). */
+VkPipeline d3d12_pipeline_state_rebox_graphics_variant(struct d3d12_pipeline_state *state,
+        const struct vkd3d_dynamic_state *dyn_state, const struct vkd3d_format *dsv_format,
+        const struct vkd3d_rebox_compile_out *vs, const struct vkd3d_rebox_compile_out *ps,
+        uint32_t *dynamic_state_flags)
+{
+    VkVertexInputAttributeDescription attributes[D3D12_VS_INPUT_REGISTER_COUNT];
+    VkVertexInputBindingDescription bindings[D3D12_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT];
+    const struct vkd3d_rebox_graphics *g = state->rebox_graphics;
+    struct d3d12_graphics_pipeline_state *graphics = &state->graphics;
+    const struct vkd3d_vk_device_procs *vk_procs = &state->device->vk_procs;
+    struct vkd3d_rebox_graphics_override override;
+    uint32_t offsets[D3D12_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT];
+    struct d3d12_device *device = state->device;
+    struct vkd3d_pipeline_key pipeline_key;
+    VkShaderModuleCreateInfo module_info;
+    VkPipeline vk_pipeline = VK_NULL_HANDLE;
+    uint32_t i, slot_mask = 0, key_hash;
+    uint64_t key[2];
+    size_t v;
+
+    memset(&pipeline_key, 0, sizeof(pipeline_key));
+    if (graphics->primitive_topology_type != D3D12_PRIMITIVE_TOPOLOGY_TYPE_PATCH &&
+            graphics->primitive_topology_type != D3D12_PRIMITIVE_TOPOLOGY_TYPE_UNDEFINED)
+        pipeline_key.dynamic_topology = true;
+    else
+        pipeline_key.topology = dyn_state->primitive_topology;
+    pipeline_key.dsv_format = dsv_format ? dsv_format->vk_format : VK_FORMAT_UNDEFINED;
+    pipeline_key.view_mask = graphics->multiview.dynamic_mask ? dyn_state->view_mask : 0;
+    if (!(graphics->pipeline_dynamic_states & VKD3D_DYNAMIC_STATE_RASTERIZATION_SAMPLES))
+        pipeline_key.rasterization_samples = dyn_state->rasterization_samples
+                ? dyn_state->rasterization_samples : graphics->ms_desc.rasterizationSamples;
+    key_hash = hash_data(&pipeline_key, sizeof(pipeline_key));
+    key[0] = vs->key[0] ^ (ps->key[0] * 0x9e3779b97f4a7c15ull) ^ key_hash;
+    key[1] = vs->key[1] ^ (ps->key[1] * 0xff51afd7ed558ccdull) ^ ((uint64_t)key_hash << 32);
+
+    rwlock_lock_read(&state->lock);
+    for (v = 0; v < state->rebox_variant_count; v++)
+        if (!memcmp(state->rebox_variants[v].key, key, sizeof(key)))
+        {
+            vk_pipeline = state->rebox_variants[v].vk_pipeline;
+            *dynamic_state_flags = state->rebox_variants[v].dynamic_state_flags;
+        }
+    rwlock_unlock_read(&state->lock);
+    if (vk_pipeline)
+        return vk_pipeline;
+
+    /* Vertex input: element r's slot, format and offset (D3D12_APPEND_ALIGNED_ELEMENT follows the
+     * slot's previous element). */
+    memset(&override, 0, sizeof(override));
+    memset(offsets, 0, sizeof(offsets));
+    for (i = 0; i < vs->vertex_input_count && override.attribute_count < ARRAY_SIZE(attributes); i++)
+    {
+        uint32_t r = vs->vertex_inputs[i][0], k, offset = 0;
+        const struct vkd3d_rebox_graphics_element *e;
+        const struct vkd3d_format *format;
+
+        if (r >= g->element_count)
+        {
+            WARN("rebox: console vertex input %u has no input layout element.\n", r);
+            continue;
+        }
+        e = &g->elements[r];
+        if (e->slot >= ARRAY_SIZE(bindings) || !(format = vkd3d_get_format(device, e->dxgi_format, false)))
+            continue;
+        for (k = 0; k <= r; k++)
+        {
+            const struct vkd3d_rebox_graphics_element *p = &g->elements[k];
+            const struct vkd3d_format *f;
+            if (p->slot != e->slot)
+                continue;
+            offset = p->offset != D3D12_APPEND_ALIGNED_ELEMENT ? p->offset : offsets[p->slot];
+            if ((f = vkd3d_get_format(device, p->dxgi_format, false)))
+                offsets[p->slot] = offset + f->byte_count;
+        }
+        attributes[override.attribute_count].location = r;
+        attributes[override.attribute_count].binding = e->slot;
+        attributes[override.attribute_count].format = format->vk_format;
+        attributes[override.attribute_count].offset = offset;
+        override.attribute_count++;
+        if (!(slot_mask & (1u << e->slot)))
+        {
+            bindings[override.binding_count].binding = e->slot;
+            bindings[override.binding_count].stride = 0; /* dynamic */
+            bindings[override.binding_count].inputRate = e->per_instance
+                    ? VK_VERTEX_INPUT_RATE_INSTANCE : VK_VERTEX_INPUT_RATE_VERTEX;
+            override.binding_count++;
+            slot_mask |= 1u << e->slot;
+        }
+    }
+    override.attributes = attributes;
+    override.bindings = bindings;
+
+    memset(&module_info, 0, sizeof(module_info));
+    module_info.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+    module_info.codeSize = vs->spirv_words * sizeof(uint32_t);
+    module_info.pCode = vs->spirv;
+    if (VK_CALL(vkCreateShaderModule(device->vk_device, &module_info, NULL, &override.vs)) < 0)
+        return VK_NULL_HANDLE;
+    module_info.codeSize = ps->spirv_words * sizeof(uint32_t);
+    module_info.pCode = ps->spirv;
+    if (VK_CALL(vkCreateShaderModule(device->vk_device, &module_info, NULL, &override.ps)) < 0)
+    {
+        VK_CALL(vkDestroyShaderModule(device->vk_device, override.vs, NULL));
+        return VK_NULL_HANDLE;
+    }
+
+    rebox_override = &override;
+    vk_pipeline = d3d12_pipeline_state_create_pipeline_variant(state, &pipeline_key, dsv_format, VK_NULL_HANDLE, 0,
+            dynamic_state_flags);
+    rebox_override = NULL;
+    VK_CALL(vkDestroyShaderModule(device->vk_device, override.vs, NULL));
+    VK_CALL(vkDestroyShaderModule(device->vk_device, override.ps, NULL));
+    if (!vk_pipeline)
+    {
+        ERR("rebox: failed to create a console graphics pipeline.\n");
+        return VK_NULL_HANDLE;
+    }
+
+    rwlock_lock_write(&state->lock);
+    for (v = 0; v < state->rebox_variant_count; v++)
+        if (!memcmp(state->rebox_variants[v].key, key, sizeof(key)))
+            break;
+    if (v < state->rebox_variant_count)
+    {
+        VK_CALL(vkDestroyPipeline(device->vk_device, vk_pipeline, NULL));
+        vk_pipeline = state->rebox_variants[v].vk_pipeline;
+        *dynamic_state_flags = state->rebox_variants[v].dynamic_state_flags;
+    }
+    else if (vkd3d_array_reserve((void **)&state->rebox_variants, &state->rebox_variant_capacity,
+            state->rebox_variant_count + 1, sizeof(*state->rebox_variants)))
+    {
+        memcpy(state->rebox_variants[state->rebox_variant_count].key, key, sizeof(key));
+        state->rebox_variants[state->rebox_variant_count].vk_pipeline = vk_pipeline;
+        state->rebox_variants[state->rebox_variant_count++].dynamic_state_flags = *dynamic_state_flags;
+    }
+    rwlock_unlock_write(&state->lock);
+    return vk_pipeline;
+}
