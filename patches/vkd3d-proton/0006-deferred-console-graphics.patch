+/* Compiles the bound PSO's deferred console vertex and pixel stages for this draw (d3d12_xs caches)
+ * and returns their pipeline, or VK_NULL_HANDLE to draw with the fallback. User SGPRs follow
+ * TomBox's reading of the console's graphics layout: root parameters from s8, one SGPR per
+ * descriptor table (a UE5 title's vertex shaders load from s[12:13] with s13 = 0), the fetch shader's
+ * address at s[4:5] (d3d12_xs puts one there). */
+static VkPipeline d3d12_command_list_rebox_graphics_pipeline(struct d3d12_command_list *list,
+        uint32_t *dynamic_state_flags)
+{
+    PFN_vkd3d_rebox_console_compile compile = vkd3d_rebox_compile_fn();
+    struct d3d12_pipeline_state *state = list->state;
+    const struct vkd3d_rebox_graphics *g = state->rebox_graphics;
+    struct vkd3d_rebox_compile_out vs, ps;
+    struct vkd3d_rebox_compile_in in;
+    uint32_t sgprs[32], root[32];
+    unsigned int n;
+    HRESULT hr;
+
+    memset(list->rebox.push, 0, sizeof(list->rebox.push));
+    if (!compile || !g || !state->root_signature)
+        return VK_NULL_HANDLE;
+    memset(&in, 0, sizeof(in));
+    memset(sgprs, 0, sizeof(sgprs));
+    memset(root, 0, sizeof(root));
+    n = d3d12_command_list_rebox_sgprs_layout(list, &list->graphics_bindings, root, true);
+    memcpy(&sgprs[8], root, min(n, 24u) * sizeof(uint32_t));
+    in.user_sgprs = sgprs;
+    in.user_sgpr_count = 32;
+    memcpy(in.heap_cpu, list->rebox.heap_cpu, sizeof(in.heap_cpu));
+    in.increment[0] = d3d12_device_get_descriptor_handle_increment_size(list->device, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    in.increment[1] = d3d12_device_get_descriptor_handle_increment_size(list->device, D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER);
+    vkd3d_rebox_bindless_targets(list->device, in.bindless);
+
+    in.shader = (const uint8_t *)g + g->vs_offset;
+    in.shader_size = g->vs_size;
+    in.push_offset = 0;
+    memset(&vs, 0, sizeof(vs));
+    if (FAILED(hr = compile(&in, &vs)))
+        return VK_NULL_HANDLE;
+    in.shader = (const uint8_t *)g + g->ps_offset;
+    in.shader_size = g->ps_size;
+    in.push_offset = 128;
+    memset(&ps, 0, sizeof(ps));
+    if (FAILED(hr = compile(&in, &ps)))
+        return VK_NULL_HANDLE;
+    memcpy(&list->rebox.push[0], vs.push, 128);
+    memcpy(&list->rebox.push[32], ps.push, 128);
+    return d3d12_pipeline_state_rebox_graphics_variant(state, &list->dynamic_state, list->dsv.format, &vs, &ps,
+            dynamic_state_flags);
+}
