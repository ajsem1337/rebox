@@ -2337,7 +2337,9 @@ struct vkd3d_rebox_compile_out
  * it created with fallback shaders, as private data (VKD3D_REBOX_GRAPHICS_GUID): the console
  * vertex and pixel stages (deferred blobs) and the input layout. At each draw both are compiled by
  * ReboxConsoleCompile, and the pipeline is the PSO's own with those two modules and vertex input
- * made from the vertex stage's attributes; if a compile fails, the fallback pipeline draws. */
+ * made from the vertex stage's attributes; if a compile fails, the fallback pipeline draws. A mesh
+ * PSO's (patch 0013) has its mesh stage in place of the vertex stage and no input layout; it
+ * compiles at each DispatchMesh and mesh ExecuteIndirect. */
 #define VKD3D_REBOX_GRAPHICS_MAGIC 0x47524353u /* "SCRG" */
 struct vkd3d_rebox_graphics_element
 {
