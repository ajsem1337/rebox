+static void vkd3d_rebox_indirect_clamp_ops_cleanup(struct vkd3d_rebox_indirect_clamp_ops *ops,
+        struct d3d12_device *device)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    VK_CALL(vkDestroyPipeline(device->vk_device, ops->vk_pipeline, NULL));
+    VK_CALL(vkDestroyPipelineLayout(device->vk_device, ops->vk_pipeline_layout, NULL));
+    VK_CALL(vkDestroyBuffer(device->vk_device, ops->vk_stats_buffer, NULL));
+    if (ops->stats_memory.vk_memory)
+        vkd3d_free_device_memory(device, &ops->stats_memory);
+    memset(ops, 0, sizeof(*ops));
+}
+
+static uint32_t vkd3d_rebox_env_u32(const char *name, uint32_t fallback)
+{
+    char value[32];
+    char *end;
+    unsigned long v;
+
+    if (!vkd3d_get_env_var(name, value, sizeof(value)))
+        return fallback;
+    v = strtoul(value, &end, 0);
+    return end != value && v && v <= UINT32_MAX ? (uint32_t)v : fallback;
+}
+
+/* rebox (patch 0017). Never fails device creation: without it, ExecuteIndirect runs unbounded as
+ * upstream does. */
+static void vkd3d_rebox_indirect_clamp_ops_init(struct vkd3d_rebox_indirect_clamp_ops *ops,
+        struct d3d12_device *device)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    VkPushConstantRange push_constant_range;
+    void *mapped;
+    char value[8];
+    VkResult vr;
+
+    memset(ops, 0, sizeof(*ops));
+
+    if (vkd3d_get_env_var("REBOX_INDIRECT_CLAMP", value, sizeof(value)) && !strcmp(value, "0"))
+    {
+        INFO("rebox: ExecuteIndirect arguments are not clamped (REBOX_INDIRECT_CLAMP=0).\n");
+        return;
+    }
+
+    /* D3D12 allows 65535 groups a dimension; more, or a total past REBOX_INDIRECT_CLAMP_GROUPS,
+     * is a buffer nobody filled. Draws: vertices (or indices) times instances. */
+    ops->max_groups_per_dim = 65535;
+    ops->max_groups = vkd3d_rebox_env_u32("REBOX_INDIRECT_CLAMP_GROUPS", 1u << 22);
+    ops->max_count_product = vkd3d_rebox_env_u32("REBOX_INDIRECT_CLAMP_VERTICES", 1u << 28);
+
+    if (FAILED(vkd3d_create_buffer_explicit_usage(device,
+            VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT,
+            8 * sizeof(uint32_t), "rebox-indirect-clamp-stats", &ops->vk_stats_buffer)))
+        goto fail;
+
+    if (FAILED(vkd3d_allocate_internal_buffer_memory(device, ops->vk_stats_buffer,
+            VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, &ops->stats_memory)))
+        goto fail;
+
+    if (VK_CALL(vkMapMemory(device->vk_device, ops->stats_memory.vk_memory, 0, VK_WHOLE_SIZE, 0, &mapped)) < 0)
+        goto fail;
+    memset(mapped, 0, 8 * sizeof(uint32_t));
+    ops->stats = mapped;
+    ops->stats_va = vkd3d_get_buffer_device_address(device, ops->vk_stats_buffer);
+
+    push_constant_range.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+    push_constant_range.offset = 0;
+    push_constant_range.size = sizeof(struct vkd3d_rebox_indirect_clamp_args);
+
+    if ((vr = vkd3d_meta_create_pipeline_layout(device, 0, NULL, 1,
+            &push_constant_range, &ops->vk_pipeline_layout)) < 0)
+        goto fail;
+
+    if ((vr = vkd3d_meta_create_compute_pipeline(device,
+            sizeof(cs_rebox_indirect_clamp), cs_rebox_indirect_clamp,
+            ops->vk_pipeline_layout, NULL, true, NULL, &ops->vk_pipeline)) < 0)
+    {
+        ops->vk_pipeline = VK_NULL_HANDLE;
+        goto fail;
+    }
+
+    INFO("rebox: ExecuteIndirect records past %u groups (%u a dimension) or %u vertices run empty.\n",
+            ops->max_groups, ops->max_groups_per_dim, ops->max_count_product);
+    return;
+
+fail:
+    ERR("rebox: no ExecuteIndirect argument clamp: its meta pass could not be made.\n");
+    vkd3d_rebox_indirect_clamp_ops_cleanup(ops, device);
+}
