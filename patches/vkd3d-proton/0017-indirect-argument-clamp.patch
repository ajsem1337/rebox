+enum vkd3d_rebox_indirect_clamp_kind
+{
+    VKD3D_REBOX_INDIRECT_CLAMP_DISPATCH = 0, /* and mesh dispatches */
+    VKD3D_REBOX_INDIRECT_CLAMP_DRAW = 1,
+    VKD3D_REBOX_INDIRECT_CLAMP_DRAW_INDEXED = 2,
