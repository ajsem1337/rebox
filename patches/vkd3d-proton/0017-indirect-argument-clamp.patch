+};
+
+struct vkd3d_rebox_indirect_clamp_ops
+{
+    VkPipelineLayout vk_pipeline_layout;
+    VkPipeline vk_pipeline; /* VK_NULL_HANDLE: off */
+    VkBuffer vk_stats_buffer;
+    struct vkd3d_device_memory_allocation stats_memory;
+    /* [0] records clamped so far, [1..5] the last one's words; the GPU writes them. */
+    const volatile uint32_t *stats;
+    VkDeviceAddress stats_va;
+    uint32_t max_groups_per_dim;
+    uint32_t max_groups;
+    uint32_t max_count_product;
+    uint32_t logged_count;
+};
+
+static inline uint32_t vkd3d_meta_get_rebox_indirect_clamp_workgroup_size(void)
+{
+    return 32;
+}
