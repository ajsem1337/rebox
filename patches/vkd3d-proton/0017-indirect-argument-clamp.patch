+/* rebox (patch 0017): the GPU counts the records it clamps; logged at 1, 2, 4, ... of them. The
+ * count is read as recording goes on, so it trails the GPU. */
+static void d3d12_device_rebox_log_indirect_clamps(struct d3d12_device *device)
+{
+    struct vkd3d_rebox_indirect_clamp_ops *ops = &device->meta_ops.rebox_indirect_clamp;
+    const volatile uint32_t *stats = ops->stats;
+    uint32_t count, logged;
+
+    count = stats[0];
+    logged = vkd3d_atomic_uint32_load_explicit(&ops->logged_count, vkd3d_memory_order_relaxed);
+    if (count <= logged || (logged && count / 2 < logged) || logged >= (1u << 30))
+        return;
+    if (vkd3d_atomic_uint32_compare_exchange(&ops->logged_count, logged, count,
+            vkd3d_memory_order_relaxed, vkd3d_memory_order_relaxed) != logged)
+        return;
+    ERR("rebox: %u ExecuteIndirect argument records past the limits ran empty so far; the last: "
+            "%#x %#x %#x %#x %#x.\n", count, stats[1], stats[2], stats[3], stats[4], stats[5]);
+}
+
+/* rebox (patch 0017): an ExecuteIndirect whose argument buffer was never filled (a console shader
+ * not compiled yet skips the dispatch that writes it) can hold anything, all ones as often as not:
+ * billions of workgroups, and the GPU watchdog resets the device. This copies the records to
+ * scratch and bounds them (cs_rebox_indirect_clamp.comp): a dispatch or mesh dispatch with a
+ * dimension of 65535 or more or more than REBOX_INDIRECT_CLAMP_GROUPS groups, or a draw of more
+ * than REBOX_INDIRECT_CLAMP_VERTICES vertices (or indices) times instances, runs empty. With a
+ * count buffer, the count is clamped to max_command_count and records past it run empty.
+ *
+ * whole_records copies each record whole, at the signature's stride (a state template's other
+ * arguments come along); otherwise only the action's arguments, tightly packed (*out_stride).
+ * Recorded where vkd3d-proton's own argument patching goes: ahead of the list while it has had no
+ * indirect argument barrier, else in place, where it ends the render pass. Returns false when the
+ * arguments are to be used as they are. */
+static bool d3d12_command_list_rebox_clamp_indirect(struct d3d12_command_list *list,
+        const struct d3d12_command_signature *signature, uint32_t max_command_count,
+        VkDeviceAddress arg_va, VkDeviceAddress count_va, bool whole_records,
+        struct vkd3d_scratch_allocation *out_args, struct vkd3d_scratch_allocation *out_count,
+        uint32_t *out_stride)
+{
+    struct vkd3d_rebox_indirect_clamp_ops *ops = &list->device->meta_ops.rebox_indirect_clamp;
+    const D3D12_COMMAND_SIGNATURE_DESC *desc = &signature->desc;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    struct vkd3d_rebox_indirect_clamp_args args;
+    uint32_t kind, action_words, dst_stride;
+    VkCommandBuffer vk_patch_cmd_buffer;
+    VkMemoryBarrier2 vk_barrier;
+    VkDependencyInfo dep_info;
+
+    if (!ops->vk_pipeline)
+        return false;
+
+    switch (desc->pArgumentDescs[desc->NumArgumentDescs - 1].Type)
+    {
+        case D3D12_INDIRECT_ARGUMENT_TYPE_DISPATCH:
+        case D3D12_INDIRECT_ARGUMENT_TYPE_DISPATCH_MESH:
+            kind = VKD3D_REBOX_INDIRECT_CLAMP_DISPATCH;
+            action_words = sizeof(D3D12_DISPATCH_ARGUMENTS) / sizeof(uint32_t);
+            break;
+        case D3D12_INDIRECT_ARGUMENT_TYPE_DRAW:
+            kind = VKD3D_REBOX_INDIRECT_CLAMP_DRAW;
+            action_words = sizeof(D3D12_DRAW_ARGUMENTS) / sizeof(uint32_t);
+            break;
+        case D3D12_INDIRECT_ARGUMENT_TYPE_DRAW_INDEXED:
+            kind = VKD3D_REBOX_INDIRECT_CLAMP_DRAW_INDEXED;
+            action_words = sizeof(D3D12_DRAW_INDEXED_ARGUMENTS) / sizeof(uint32_t);
+            break;
+        default:
+            return false;
+    }
+
+    d3d12_device_rebox_log_indirect_clamps(list->device);
+
+    dst_stride = whole_records ? desc->ByteStride : action_words * sizeof(uint32_t);
+    /* Unreasonable sizes are left alone rather than given hundreds of MiB of scratch. */
+    if ((uint64_t)dst_stride * max_command_count > (64u << 20))
+    {
+        static unsigned int logged;
+        if (logged++ < 4)
+            ERR("rebox: ExecuteIndirect of up to %u records of %u bytes not clamped: too large.\n",
+                    max_command_count, desc->ByteStride);
+        return false;
+    }
+
+    if (!d3d12_command_allocator_allocate_scratch_memory(list->allocator,
+            VKD3D_SCRATCH_POOL_KIND_DEVICE_STORAGE,
+            (VkDeviceSize)dst_stride * max_command_count, 64, ~0u, out_args))
+        return false;
+
+    if (count_va && !d3d12_command_allocator_allocate_scratch_memory(list->allocator,
+            VKD3D_SCRATCH_POOL_KIND_DEVICE_STORAGE, sizeof(uint32_t), sizeof(uint32_t), ~0u, out_count))
+        return false;
+
+    memset(&args, 0, sizeof(args));
+    args.src_va = arg_va;
+    args.count_va = count_va;
+    args.dst_va = out_args->va;
+    args.count_out_va = count_va ? out_count->va : 0;
+    args.stats_va = ops->stats_va;
+    args.src_stride_words = desc->ByteStride / sizeof(uint32_t);
+    args.dst_stride_words = dst_stride / sizeof(uint32_t);
+    args.src_action_word = signature->argument_buffer_offset_for_command / sizeof(uint32_t);
+    /* The action is a record's last argument; the padding after it may be past the buffer's end. */
+    args.copy_words = whole_records ? args.src_action_word + action_words : 0;
+    args.dst_action_word = whole_records ? args.src_action_word : 0;
+    args.kind = kind;
+    args.max_commands = max_command_count;
+    args.max_groups_per_dim = ops->max_groups_per_dim;
+    args.max_groups = ops->max_groups;
+    args.max_count_product = ops->max_count_product;
+
+    d3d12_command_list_end_transfer_batch(list);
+
+    d3d12_command_allocator_allocate_init_post_indirect_command_buffer(list->allocator, list);
+    vk_patch_cmd_buffer = list->cmd.vk_post_indirect_barrier_commands;
+
+    if (vk_patch_cmd_buffer == list->cmd.vk_command_buffer)
+    {
+        d3d12_command_list_end_current_render_pass(list, true);
+        /* The copy must run whatever the predicate says: the command it feeds re-arms predication. */
+        d3d12_command_list_update_conditional_rendering_state(list, true);
+        d3d12_command_list_invalidate_current_pipeline(list, true);
+        d3d12_command_list_invalidate_root_parameters(list, &list->compute_bindings, true, &list->graphics_bindings);
+    }
+    else
+        list->cmd.indirect_meta->need_compute_to_indirect_barrier = true;
+
+    VK_CALL(vkCmdBindPipeline(vk_patch_cmd_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, ops->vk_pipeline));
+    VK_CALL(vkCmdPushConstants(vk_patch_cmd_buffer, ops->vk_pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT,
+            0, sizeof(args), &args));
+    VK_CALL(vkCmdDispatch(vk_patch_cmd_buffer,
+            vkd3d_compute_workgroup_count(max_command_count, vkd3d_meta_get_rebox_indirect_clamp_workgroup_size()),
+            1, 1));
+
+    /* In both places: what reads the copy may be recorded into the same command buffer (the
+     * predication pass, a state template's patch shader or preprocess). */
+    memset(&vk_barrier, 0, sizeof(vk_barrier));
+    vk_barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2;
+    vk_barrier.srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    vk_barrier.srcAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT;
+    vk_barrier.dstStageMask = VK_PIPELINE_STAGE_2_DRAW_INDIRECT_BIT | VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    vk_barrier.dstAccessMask = VK_ACCESS_2_INDIRECT_COMMAND_READ_BIT | VK_ACCESS_2_SHADER_READ_BIT;
+    if (list->device->device_info.device_generated_commands_features.deviceGeneratedCommands)
+    {
+        vk_barrier.dstStageMask |= VK_PIPELINE_STAGE_2_COMMAND_PREPROCESS_BIT_EXT;
+        vk_barrier.dstAccessMask |= VK_ACCESS_2_COMMAND_PREPROCESS_READ_BIT_EXT;
+    }
+
+    memset(&dep_info, 0, sizeof(dep_info));
+    dep_info.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+    dep_info.memoryBarrierCount = 1;
+    dep_info.pMemoryBarriers = &vk_barrier;
+    VK_CALL(vkCmdPipelineBarrier2(vk_patch_cmd_buffer, &dep_info));
+
+    VKD3D_BREADCRUMB_COMMAND(EXECUTE_INDIRECT_PATCH_COMPUTE);
+    *out_stride = dst_stride;
+    return true;
+}
