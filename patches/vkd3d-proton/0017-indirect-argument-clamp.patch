diff --git a/libs/vkd3d/shaders/cs_rebox_indirect_clamp.comp b/libs/vkd3d/shaders/cs_rebox_indirect_clamp.comp
new file mode 100644
index 0000000..e0b8759
--- /dev/null
+++ b/libs/vkd3d/shaders/cs_rebox_indirect_clamp.comp
@@ -0,0 +1,139 @@
+#version 450
+#extension GL_EXT_buffer_reference : require
+#extension GL_EXT_buffer_reference_uvec2 : require
+
+/* rebox (patch 0017): copies ExecuteIndirect's argument records to scratch, bounding each record's
+ * dispatch, draw or mesh dispatch before the GPU runs it. A record whose group, vertex, index or
+ * instance counts are past the limits (an argument buffer the title never filled holds anything,
+ * often all ones) becomes empty; so does a record past the count buffer's count, which is
+ * clamped to MaxCommandCount. One invocation per record. */
+
+layout(local_size_x = 32) in;
+
+layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Src
+{
+	uint values[];
+};
+
+layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Dst
+{
+	uint values[];
+};
+
+layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Count
+{
+	uint value;
+};
+
+layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer CountOut
+{
+	uint value;
+};
+
+/* [0] records clamped so far, [1..5] the last one's words. */
+layout(buffer_reference, std430, buffer_reference_align = 4) buffer Stats
+{
+	uint values[];
+};
+
+#define KIND_DISPATCH 0u
+#define KIND_DRAW 1u
+#define KIND_DRAW_INDEXED 2u
+
+layout(push_constant) uniform Registers
+{
+	Src src;
+	uvec2 count_va;
+	Dst dst;
+	CountOut count_out;
+	uvec2 stats_va;
+	uint src_stride_words;
+	uint dst_stride_words;
+	/* Words of each record copied as they are (a state template's other arguments), else 0. */
+	uint copy_words;
+	uint src_action_word;
+	uint dst_action_word;
+	uint kind;
+	uint max_commands;
+	uint max_groups_per_dim; /* a dimension at or above this is garbage */
+	uint max_groups;
+	uint max_count_product; /* vertex (or index) count times instance count */
+};
+
+bool product_above(uint a, uint b, uint limit)
+{
+	uint hi, lo;
+	umulExtended(a, b, hi, lo);
+	return hi != 0u || lo > limit;
+}
+
+void main()
+{
+	uint i = gl_GlobalInvocationID.x;
+	if (i >= max_commands)
+		return;
+
+	uint n = max_commands;
+	if (any(notEqual(count_va, uvec2(0))))
+	{
+		n = min(Count(count_va).value, max_commands);
+		if (i == 0u)
+			count_out.value = n;
+	}
+
+	uint action_words = kind == KIND_DISPATCH ? 3u : (kind == KIND_DRAW ? 4u : 5u);
+	uint src_base = i * src_stride_words;
+	uint dst_base = i * dst_stride_words;
+	uint w[5] = uint[5](0u, 0u, 0u, 0u, 0u);
+	bool live = i < n;
+	bool clamp = false;
+
+	/* Past the count nothing is read: the title's buffer may end there. */
+	if (live)
+	{
+		for (uint j = 0u; j < copy_words; j++)
+			dst.values[dst_base + j] = src.values[src_base + j];
+
+		for (uint j = 0u; j < action_words; j++)
+			w[j] = src.values[src_base + src_action_word + j];
+
+		if (kind == KIND_DISPATCH)
+		{
+			clamp = any(greaterThanEqual(uvec3(w[0], w[1], w[2]), uvec3(max_groups_per_dim))) ||
+					product_above(w[0], w[1], max_groups) ||
+					product_above(w[0] * w[1], w[2], max_groups);
+		}
+		else
+		{
+			/* Draw: vertex count, instance count; indexed: index count, instance count. */
+			clamp = product_above(w[0], w[1], max_count_product);
+		}
+	}
+
+	if (clamp && any(notEqual(stats_va, uvec2(0))))
+	{
+		Stats stats = Stats(stats_va);
+		atomicAdd(stats.values[0], 1u);
+		for (uint j = 0u; j < 5u; j++)
+			stats.values[1u + j] = w[j];
+	}
+
+	if (!live || clamp)
+	{
+		if (kind == KIND_DISPATCH)
+		{
+			w[0] = 0u;
+			w[1] = 0u;
+			w[2] = 0u;
+		}
+		else
+		{
+			/* No vertices or indices and no instances; the rest is harmless as it is. */
+			w[0] = 0u;
+			w[1] = 0u;
+		}
+	}
+
+	for (uint j = 0u; j < action_words; j++)
+		dst.values[dst_base + dst_action_word + j] = w[j];
+}
