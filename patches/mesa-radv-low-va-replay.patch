+/* rebox: a replayed address in the lower half of the VA space is
+ * allocated there instead of being refused. Console titles use one address
+ * space for CPU and GPU, so their GPU-visible memory has to sit at its CPU
+ * address, which is always in the lower half. Ordinary allocations, and
+ * replayed addresses from real captures (always upper half), are unchanged. */
+static uint64_t
+radv_amdgpu_va_range_flags(uint64_t replay_address, enum radeon_bo_flag flags)
+{
+   const bool low = replay_address && replay_address < (1ull << 47) && !(flags & RADEON_FLAG_32BIT);
+
+   return (low ? 0 : AMDGPU_VA_RANGE_HIGH) | (flags & RADEON_FLAG_32BIT ? AMDGPU_VA_RANGE_32_BIT : 0) |
+          (flags & RADEON_FLAG_REPLAYABLE ? AMDGPU_VA_RANGE_REPLAYABLE : 0);
+}
+
+/* rebox: a lower-half replay address (see radv_amdgpu_va_range_flags). */
+static bool
+radv_amdgpu_low_replay(uint64_t replay_address, enum radeon_bo_flag flags)
+{
+   return replay_address && replay_address < (1ull << 47) && !(flags & RADEON_FLAG_32BIT);
+}
