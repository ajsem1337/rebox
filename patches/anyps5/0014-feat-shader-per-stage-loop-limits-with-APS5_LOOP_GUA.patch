diff --git a/core/shader/recompiler/LoopGuard.hpp b/core/shader/recompiler/LoopGuard.hpp
index 7051f98dc2..5cdbb467f4 100644
--- a/core/shader/recompiler/LoopGuard.hpp
+++ b/core/shader/recompiler/LoopGuard.hpp
@@ -1,17 +1,74 @@
 #ifndef CORE_SHADER_RECOMPILER_LOOPGUARD_HPP
 #define CORE_SHADER_RECOMPILER_LOOPGUARD_HPP
 
+#include "IntermediateRepresentation/IrMetadata/ShaderStage.hpp"
+#include <algorithm>
 #include <cstdint>
 #include <cstdlib>
+#include <cstring>
 
 namespace ShaderRecompiler {
 
+struct LoopGuardLimits {
+    std::uint32_t pixel = 0;
+    std::uint32_t vertex = 0;
+    std::uint32_t mesh = 0;
+    std::uint32_t compute = 0;
+
+    [[nodiscard]] std::uint32_t For(IrShaderStage stage) const {
+        switch (stage) {
+            case IrShaderStage::Pixel: return pixel;
+            case IrShaderStage::Mesh: return mesh;
+            case IrShaderStage::Compute: return compute;
+            default: return vertex;
+        }
+    }
+
+    [[nodiscard]] std::uint32_t Any() const {
+        return std::max({pixel, vertex, mesh, compute});
+    }
+
+    [[nodiscard]] std::uint64_t Key() const {
+        std::uint64_t key = 0xcbf29ce484222325ull;
+        for (const auto limit : {pixel, vertex, mesh, compute}) key = (key ^ limit) * 0x100000001b3ull;
+        return pixel == vertex && vertex == mesh && mesh == compute ? pixel : key;
+    }
+};
+
+inline constexpr LoopGuardLimits LoopGuardStageDefaults{128u, 256u, 256u, 4096u};
+
+template <typename TGetEnvironment>
+[[nodiscard]] LoopGuardLimits ParseLoopGuardLimits(TGetEnvironment&& getEnvironment) {
+    const char* text = getEnvironment("APS5_LOOP_GUARD");
+    if (text == nullptr) return {};
+    LoopGuardLimits limits;
+    if (std::strcmp(text, "stages") == 0) {
+        limits = LoopGuardStageDefaults;
+    } else {
+        const auto limit = static_cast<std::uint32_t>(std::strtoul(text, nullptr, 0));
+        limits = {limit, limit, limit, limit};
+    }
+    const auto stage = [&](const char* name, std::uint32_t& limit) {
+        if (const char* value = getEnvironment(name)) limit = static_cast<std::uint32_t>(std::strtoul(value, nullptr, 0));
+    };
+    stage("APS5_LOOP_GUARD_PIXEL", limits.pixel);
+    stage("APS5_LOOP_GUARD_VERTEX", limits.vertex);
+    stage("APS5_LOOP_GUARD_MESH", limits.mesh);
+    stage("APS5_LOOP_GUARD_COMPUTE", limits.compute);
+    return limits;
+}
+
+[[nodiscard]] inline const LoopGuardLimits& CurrentLoopGuardLimits() {
+    static const LoopGuardLimits limits = ParseLoopGuardLimits([](const char* name) { return static_cast<const char*>(std::getenv(name)); });
+    return limits;
+}
+
 [[nodiscard]] inline std::uint32_t LoopGuardLimit() {
-    static const std::uint32_t limit = [] {
-        const char* text = std::getenv("APS5_LOOP_GUARD");
-        return text == nullptr ? 0u : static_cast<std::uint32_t>(std::strtoul(text, nullptr, 0));
-    }();
-    return limit;
+    return CurrentLoopGuardLimits().Any();
+}
+
+[[nodiscard]] inline std::uint32_t LoopGuardLimit(IrShaderStage stage) {
+    return CurrentLoopGuardLimits().For(stage);
 }
 
 }
