diff --git a/core/shader/recompiler/tests/LoopGuardStageTests.cpp b/core/shader/recompiler/tests/LoopGuardStageTests.cpp
new file mode 100644
index 0000000000..b116143805
--- /dev/null
+++ b/core/shader/recompiler/tests/LoopGuardStageTests.cpp
@@ -0,0 +1,121 @@
+#include "BdaAbi.hpp"
+#include "LoopGuard.hpp"
+#include "Recompiler.hpp"
+#include <spirv/unified1/spirv.hpp>
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <initializer_list>
+#include <optional>
+#include <span>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+using namespace ShaderRecompiler;
+
+namespace {
+
+void Require(bool condition, const char* message) {
+    if (!condition) {
+        std::fprintf(stderr, "Requirement failed: %s\n", message);
+        std::abort();
+    }
+}
+
+LoopGuardLimits Parse(std::initializer_list<std::pair<const char*, const char*>> environment) {
+    return ParseLoopGuardLimits([&](const char* name) -> const char* {
+        for (const auto& [key, value] : environment) {
+            if (std::strcmp(key, name) == 0) return value;
+        }
+        return nullptr;
+    });
+}
+
+void TestParsing() {
+    const auto off = Parse({});
+    Require(off.Any() == 0u, "no APS5_LOOP_GUARD guards no stage");
+    Require(Parse({{"APS5_LOOP_GUARD_PIXEL", "64"}}).Any() == 0u, "a stage limit alone guards nothing");
+
+    const auto one = Parse({{"APS5_LOOP_GUARD", "0x100000"}});
+    for (const auto stage : {IrShaderStage::Pixel, IrShaderStage::Vertex, IrShaderStage::Mesh, IrShaderStage::Compute, IrShaderStage::Local, IrShaderStage::TessellationControl}) {
+        Require(one.For(stage) == 0x100000u, "one limit applies to every stage");
+    }
+    Require(one.Key() == 0x100000u, "one limit keys the disk cache as before");
+
+    const auto stages = Parse({{"APS5_LOOP_GUARD", "stages"}});
+    Require(stages.For(IrShaderStage::Pixel) == 128u, "pixel loops stop after 128 iterations");
+    Require(stages.For(IrShaderStage::Vertex) == 256u && stages.For(IrShaderStage::TessellationEvaluation) == 256u, "vertex-side loops stop after 256 iterations");
+    Require(stages.For(IrShaderStage::Mesh) == 256u, "mesh loops stop after 256 iterations");
+    Require(stages.For(IrShaderStage::Compute) == 4096u, "compute loops stop after 4096 iterations");
+    Require(stages.Key() != one.Key() && stages.Key() != Parse({{"APS5_LOOP_GUARD", "256"}}).Key(), "per-stage limits key the disk cache apart");
+
+    const auto mixed = Parse({{"APS5_LOOP_GUARD", "4096"}, {"APS5_LOOP_GUARD_PIXEL", "128"}, {"APS5_LOOP_GUARD_COMPUTE", "0"}});
+    Require(mixed.For(IrShaderStage::Pixel) == 128u && mixed.For(IrShaderStage::Vertex) == 4096u, "a stage limit overrides APS5_LOOP_GUARD for that stage");
+    Require(mixed.For(IrShaderStage::Compute) == 0u, "a stage limit of 0 leaves that stage unguarded");
+}
+
+constexpr std::array<std::uint32_t, 5> EndlessLoop{
+    0xbe880381u,
+    0x80088108u,
+    0xbf078008u,
+    0xbf85fffdu,
+    0xbf810000u,
+};
+
+SpirvTarget Target() {
+    static constexpr std::array<std::uint32_t, 4> capabilities{spv::CapabilityInt64, spv::CapabilityPhysicalStorageBufferAddresses, spv::CapabilityGroupNonUniformBallot, spv::CapabilityGroupNonUniformVote};
+    static constexpr std::array<std::string_view, 1> extensions{"SPV_KHR_physical_storage_buffer"};
+    return {0x00402000u, 0x00010500u, 32u, BdaAbi::Version, capabilities, extensions, false, {1024, 1024, 64}, 1024, 65536, {}, {}};
+}
+
+bool HasConstant(std::span<const std::uint32_t> words, std::uint32_t value) {
+    for (std::size_t index = 5; index < words.size();) {
+        const auto count = words[index] >> 16u;
+        Require(count != 0u && index + count <= words.size(), "the module's instructions are well formed");
+        if ((words[index] & 0xffffu) == spv::OpConstant && count == 4u && words[index + 3] == value) return true;
+        index += count;
+    }
+    return false;
+}
+
+void TestComputeLimit() {
+    Require(LoopGuardLimit(IrShaderStage::Compute) == 1000u && LoopGuardLimit(IrShaderStage::Pixel) == 128u, "the process's limits come from the environment");
+    const ShaderComputeStageInfo compute{{1u, 1u, 1u}, 0u, {false, false, false}, false, 1u};
+    const std::vector<MemoryRegion> regions;
+    RecompileRequest request{
+        {ShaderStage::Compute, 0x10000000u, std::span<const std::uint32_t>(EndlessLoop), 0, {}},
+        {32u, 0, {}, compute, std::nullopt, std::nullopt, MemoryRegionView(std::span<const MemoryRegion>(regions)), ShaderFloatMode{}},
+        Target(),
+        {0, 0, 0, 128},
+    };
+    request.useCache = false;
+    const auto result = Recompile(request);
+    const auto words = result.spirv.Words();
+    Require(HasConstant(words, 1000u), "a compute loop is guarded with the compute limit");
+    Require(!HasConstant(words, 128u) && !HasConstant(words, 256u), "a compute loop is not guarded with another stage's limit");
+}
+
+}
+
+int main() {
+#ifdef _WIN32
+    _putenv("APS5_LOOP_GUARD=stages");
+    _putenv("APS5_LOOP_GUARD_COMPUTE=1000");
+#else
+    setenv("APS5_LOOP_GUARD", "stages", 1);
+    setenv("APS5_LOOP_GUARD_COMPUTE", "1000", 1);
+#endif
+    try {
+        TestParsing();
+        TestComputeLimit();
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+    std::puts("loop guard stage tests passed");
+    return 0;
+}
