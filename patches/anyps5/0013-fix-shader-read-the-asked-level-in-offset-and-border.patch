+using namespace ShaderRecompiler;
+
+
+namespace {
+
+void Require(bool condition, const char* message) {
+    if (!condition) {
+        std::fprintf(stderr, "Requirement failed: %s\n", message);
+        std::abort();
+    }
+}
+
+constexpr std::uint64_t TableAddress = 0x20000000u;
+
+std::vector<std::uint32_t> GatherShader(bool offset) {
+    std::vector<std::uint32_t> code{
+        0xf40c0200u, 0xfa000000u,   // s_load_dwordx8 s[8:15], s[0:1], 0x0
+        0xf4080400u, 0xfa000020u,   // s_load_dwordx4 s[16:19], s[0:1], 0x20
+        0xf4080500u, 0xfa000030u,   // s_load_dwordx4 s[20:23], s[0:1], 0x30
+        0xbf8cc07fu,                // s_waitcnt lgkmcnt(0)
+    };
+    if (offset) {
+        code.insert(code.end(), {0x7e0002ffu, 0x00000202u}); // v_mov_b32 v0, 0x202
+        code.insert(code.end(), {0x7e0202f0u, 0x7e0402f0u, 0x7e0602f4u}); // v1 = v2 = 0.5, v3 = 2.0
+        code.insert(code.end(), {0xf1500108u, 0x00820400u}); // image_gather4_l_o v[4:7], v[0:3], s[8:15], s[16:19] dmask 0x1
+    } else {
+        code.insert(code.end(), {0x7e0202f0u, 0x7e0402f0u, 0x7e0602f4u}); // v1 = v2 = 0.5, v3 = 2.0
+        code.insert(code.end(), {0xf1100108u, 0x00820401u}); // image_gather4_l v[4:7], v[1:3], s[8:15], s[16:19] dmask 0x1
+    }
+    code.insert(code.end(), {
+        0xbf8c3f70u,                // s_waitcnt vmcnt(0)
+        0xe0700000u, 0x80050400u,   // buffer_store_dword v4, off, s[20:23], 0
+        0xbf810000u,                // s_endpgm
+    });
+    return code;
+}
+
+std::array<std::uint32_t, 16> Table(std::uint32_t clamp, std::uint32_t borderType) {
+    std::array<std::uint32_t, 16> table{};
+    table[0] = 0x40000000u >> 8u;
+    table[1] = (56u << 20u) | (3u << 30u);          // 8_8_8_8_UNORM, WIDTH-1 low bits
+    table[2] = 15u | (63u << 14u);                  // 64x64
+    table[3] = 0xfacu | (6u << 16u) | (9u << 28u);  // XYZW, levels 0-6, 2D
+    table[5] = 6u << 4u;                            // MAX_MIP
+    table[8] = clamp | (clamp << 3u) | (clamp << 6u);
+    table[9] = 0xfff000u;                           // MAX_LOD
+    table[10] = 0x5000000u;                         // filters
+    table[11] = borderType << 30u;
+    table[12] = 0x30000000u;                        // V#: the output
+    table[14] = 16u;
+    table[15] = 0xfacu | (77u << 12u);
+    return table;
+}
+
+SpirvTarget Target() {
+    static constexpr std::array<std::uint32_t, 6> capabilities{spv::CapabilityInt64, spv::CapabilityPhysicalStorageBufferAddresses, spv::CapabilityImageQuery,
+                                                               spv::CapabilityImageGatherExtended, spv::CapabilityGroupNonUniformBallot, spv::CapabilityGroupNonUniformVote};
+    static constexpr std::array<std::string_view, 1> extensions{"SPV_KHR_physical_storage_buffer"};
+    return {0x00402000u, 0x00010500u, 32u, BdaAbi::Version, capabilities, extensions, false, {1024, 1024, 64}, 1024, 65536, {}, {}};
+}
+
+RecompileResult Compile(const std::vector<std::uint32_t>& code, const std::array<std::uint32_t, 16>& table) {
+    static const std::array<std::uint32_t, 2> userData{static_cast<std::uint32_t>(TableAddress), 0u};
+    static std::array<std::byte, 64u * 1024u> buffer{};
+    std::array<std::byte, sizeof(table)> bytes{};
+    std::memcpy(bytes.data(), table.data(), sizeof(table));
+    const std::vector<MemoryRegion> regions{{TableAddress, std::span<const std::byte>(bytes)}, {0x30000000u, std::span<const std::byte>(buffer)}};
+    const ShaderComputeStageInfo compute{{1u, 1u, 1u}, 0u, {false, false, false}, false, 1u};
+    RecompileRequest request{
+        {ShaderStage::Compute, 0x10000000u, std::span<const std::uint32_t>(code), 0, {}},
+        {32u, 0, std::span<const std::uint32_t>(userData), compute, std::nullopt, std::nullopt, MemoryRegionView(std::span<const MemoryRegion>(regions)), ShaderFloatMode{}},
+        Target(),
+        {0, 0, 0, 128},
+    };
+    request.useCache = false;
+    return Recompile(request);
+}
+
+struct Counts {
+    std::size_t gathers = 0;
+    std::size_t lodFetches = 0;
+};
+
+Counts Specialized(const RecompileResult& result) {
+    const auto view = result.spirv.Words();
+    std::vector<std::uint32_t> words(view.begin(), view.end());
+    std::string log;
+    spvtools::SpirvTools tools(SPV_ENV_VULKAN_1_2);
+    tools.SetMessageConsumer([&](spv_message_level_t, const char*, const spv_position_t&, const char* message) { log += message; });
+    spvtools::ValidatorOptions options;
+    options.SetScalarBlockLayout(true);
+    if (!tools.Validate(words.data(), words.size(), options)) std::fprintf(stderr, "%s\n", log.c_str());
+    Require(tools.Validate(words.data(), words.size(), options), "the gather module validates");
+    if (const char* dump = std::getenv("GATHER_LOD_DUMP")) {
+        static int serial = 0;
+        const std::string path = std::string(dump) + std::to_string(serial++) + ".spv";
+        if (FILE* file = std::fopen(path.c_str(), "wb")) {
+            std::fwrite(words.data(), 4, words.size(), file);
+            std::fclose(file);
+        }
+    }
+
+    std::unordered_map<std::uint32_t, std::string> defaults;
+    for (const auto& constant : result.specialization) defaults[constant.id] = std::to_string(constant.value);
+    spvtools::Optimizer optimizer(SPV_ENV_VULKAN_1_2);
+    optimizer.SetMessageConsumer([](spv_message_level_t, const char*, const spv_position_t&, const char*) {});
+    optimizer.RegisterPass(spvtools::CreateSetSpecConstantDefaultValuePass(defaults));
+    optimizer.RegisterPass(spvtools::CreateFreezeSpecConstantValuePass());
+    optimizer.RegisterPerformancePasses();
+    std::vector<std::uint32_t> optimized;
+    spvtools::OptimizerOptions optimizerOptions;
+    optimizerOptions.set_run_validator(false);
+    Require(optimizer.Run(words.data(), words.size(), &optimized, optimizerOptions), "the specialized module optimizes");
+
+    std::vector<std::pair<std::uint32_t, bool>> reads;
+    std::vector<std::uint32_t> operands;
+    for (std::size_t index = 5; index < optimized.size();) {
+        const auto count = optimized[index] >> 16u;
+        Require(count != 0u && index + count <= optimized.size(), "the optimized module's instructions are well formed");
+        const auto op = optimized[index] & 0xffffu;
+        const bool fetch = op == spv::OpImageFetch && count > 5u && (optimized[index + 5] & spv::ImageOperandsLodMask) != 0u;
+        if (op == spv::OpImageGather || fetch) reads.push_back({optimized[index + 2], op == spv::OpImageGather});
+        for (std::size_t word = (op == spv::OpImageGather || op == spv::OpImageFetch) ? 3u : 1u; word < count; word++) operands.push_back(optimized[index + word]);
+        index += count;
+    }
+    Counts counts;
+    for (const auto& [id, gather] : reads) {
+        if (std::ranges::find(operands, id) == operands.end()) continue;
+        if (gather) counts.gathers++;
+        else counts.lodFetches++;
+    }
+    return counts;
+}
+
+void TestBorderGather(bool offset) {
+    const auto result = Compile(GatherShader(offset), Table(6u, 0u));
+    const auto counts = Specialized(result);
+    Require(counts.gathers == 0u, offset ? "an offset gather at an explicit level through a border sampler still reads level 0" : "a gather at an explicit level through a border sampler still reads level 0");
+    Require(counts.lodFetches == 4u, "the four texels are fetched at a level");
+}
+
+void TestPaletteBorderKeepsGather() {
+    const auto counts = Specialized(Compile(GatherShader(true), Table(6u, 3u)));
+    Require(counts.gathers == 1u, "a gather through a palette border sampler is not emulated");
+}
+
+void TestWrapGather() {
+    const auto counts = Specialized(Compile(GatherShader(true), Table(0u, 0u)));
+    Require(counts.gathers == 0u && counts.lodFetches == 4u, "an offset gather at an explicit level through a wrapping sampler still reads level 0");
+}
+
+}
+
+int main() {
+    try {
+        TestBorderGather(false);
+        TestBorderGather(true);
+        TestPaletteBorderKeepsGather();
+        TestWrapGather();
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+    std::puts("gather LOD tests passed");
+    return 0;
+}
