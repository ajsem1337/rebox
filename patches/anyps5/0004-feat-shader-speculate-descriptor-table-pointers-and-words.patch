diff --git a/core/libs/prx/libSceAgcDriver/tests/DescriptorPointerSpeculation.cpp b/core/libs/prx/libSceAgcDriver/tests/DescriptorPointerSpeculation.cpp
new file mode 100644
index 0000000000..8372380078
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/tests/DescriptorPointerSpeculation.cpp
@@ -0,0 +1,101 @@
+#include "BdaAbi.hpp"
+#include "Recompiler.hpp"
+#include <array>
+#include <cstdint>
+#include <cstdlib>
+#include <cstdio>
+#include <exception>
+#include <span>
+#include <spirv/unified1/spirv.hpp>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+
+using namespace ShaderRecompiler;
+
+namespace {
+
+void Check(bool condition, const std::string& message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+SpirvTarget Target() {
+    static constexpr std::array<std::uint32_t, 5> capabilities{
+        spv::CapabilityInt64, spv::CapabilityPhysicalStorageBufferAddresses, spv::CapabilityStorageBuffer8BitAccess, spv::CapabilityClipDistance, spv::CapabilityInt64Atomics,
+    };
+    static constexpr std::array<std::string_view, 4> extensions{
+        "SPV_EXT_descriptor_indexing", "SPV_KHR_8bit_storage", "SPV_KHR_float_controls", "SPV_KHR_physical_storage_buffer",
+    };
+    return {0x00401000u, 0x00010300u, 32, BdaAbi::Version, capabilities, extensions, false,
+            {1024, 1024, 64}, 1024, 32768, {}, {}};
+}
+
+alignas(256) constexpr std::array<std::uint32_t, 16> PointerClobbered{
+    0xbe940300u, 0xbe950301u, 0xbf068002u, 0xbf850002u, 0x7d880083u, 0xbe94036au, 0xf40c020au, 0xfa000000u,
+    0x7e020300u, 0x7e040300u, 0x7e060300u, 0x7e080300u, 0xbf8cc07fu, 0xf0201f00u, 0x00020100u, 0xbf810000u,
+};
+
+alignas(256) constexpr std::array<std::uint32_t, 16> DescriptorClobbered{
+    0xbe940300u, 0xbe950301u, 0xf40c020au, 0xfa000000u, 0xbf8cc07fu, 0xbf068002u, 0xbf850002u, 0x7d880083u,
+    0xbe88036au, 0x7e020300u, 0x7e040300u, 0x7e060300u, 0x7e080300u, 0xf0201f00u, 0x00020100u, 0xbf810000u,
+};
+
+RecompileResult Compile(std::span<const std::uint32_t> code) {
+    constexpr std::uint32_t Width = 32u;
+    constexpr std::uint32_t Format32x4Float = 77u;
+    constexpr std::uint32_t Type1D = 8u;
+    alignas(256) static std::array<std::uint32_t, Width * 4u> texels{};
+    alignas(256) static std::array<std::uint32_t, 8> table{};
+    const auto texelAddress = static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(texels.data()));
+    table = {
+        static_cast<std::uint32_t>(texelAddress >> 8u),
+        static_cast<std::uint32_t>((texelAddress >> 40u) & 0xffu) | (Format32x4Float << 20u) | (((Width - 1u) & 3u) << 30u),
+        (Width - 1u) >> 2u,
+        0xfacu | (Type1D << 28u),
+        0u, 0u, 0u, 0u,
+    };
+    const auto tableAddress = reinterpret_cast<std::uintptr_t>(table.data());
+    const std::array<std::uint32_t, 2> userData{static_cast<std::uint32_t>(tableAddress), static_cast<std::uint32_t>(tableAddress >> 32u)};
+    const std::array<MemoryRegion, 3> memory{{
+        {reinterpret_cast<std::uintptr_t>(code.data()), std::as_bytes(code)},
+        {tableAddress, std::as_bytes(std::span<const std::uint32_t>(table))},
+        {static_cast<std::uintptr_t>(texelAddress), std::as_bytes(std::span<const std::uint32_t>(texels))},
+    }};
+    RecompileRequest request{};
+    request.shader = {ShaderStage::Compute, reinterpret_cast<std::uintptr_t>(code.data()), code, 0, {}};
+    request.target = Target();
+    request.layout = {0, 0, 0, 128};
+    request.context.waveSize = 32;
+    request.context.userDataBaseRegister = 0;
+    request.context.userData = userData;
+    request.context.compute = ShaderComputeStageInfo{{32u, 1u, 1u}, 0u, {true, false, false}, false, 1u};
+    request.context.memory = memory;
+    request.useCache = false;
+    return Recompile(request);
+}
+
+void CheckSpeculated(std::span<const std::uint32_t> code, const char* what) {
+    const auto result = Compile(code);
+    Check(!result.bindings.empty(), std::string(what) + ": the image store produced no binding");
+    Check(result.descriptorFaults != 0u, std::string(what) + ": the speculated descriptor has no runtime check");
+}
+
+}
+
+int main() {
+#ifdef _WIN32
+    _putenv_s("APS5_SPECULATE_DESCRIPTORS", "1");
+#else
+    setenv("APS5_SPECULATE_DESCRIPTORS", "1", 1);
+#endif
+    try {
+        CheckSpeculated(PointerClobbered, "a table pointer clobbered with a lane mask on an unexecuted path");
+        CheckSpeculated(DescriptorClobbered, "a T# word clobbered with a lane mask on an unexecuted path");
+        std::puts("descriptor pointer and word speculation pass");
+        return 0;
+    } catch (const std::exception& error) {
+        const std::string message = error.what();
+        std::fprintf(stderr, "%s\n", message.substr(0, message.find("\nRecompileRequest:")).c_str());
+        return 1;
+    }
+}
