diff --git a/core/shader/recompiler/Optimization/src/DescriptorPointerSpeculation.cpp b/core/shader/recompiler/Optimization/src/DescriptorPointerSpeculation.cpp
new file mode 100644
index 0000000000..ecfb00c59a
--- /dev/null
+++ b/core/shader/recompiler/Optimization/src/DescriptorPointerSpeculation.cpp
@@ -0,0 +1,363 @@
+#include "Optimization/DescriptorPointerSpeculation.hpp"
+#include "IntermediateRepresentation/IrBuilder.hpp"
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <initializer_list>
+#include <optional>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace ShaderRecompiler {
+
+namespace {
+
+constexpr std::size_t MaxLeafVisits = 4096;
+
+bool IsLoad(const IrValue& value) {
+    const auto opcode = value.Opcode();
+    if (opcode != IrOpcode::LoadAddressU32 && opcode != IrOpcode::ReadConst && opcode != IrOpcode::ReadConstBuffer) return false;
+    for (std::size_t index = 1; index < value.ArgumentCount(); ++index) {
+        const IrValue* argument = value.Argument(index);
+        if (argument != nullptr && !argument->Resolve()->HasImmediate()) return false;
+    }
+    return true;
+}
+
+struct Leaves {
+    std::unordered_set<IrValue*> candidates;
+    std::unordered_set<IrValue*> loads;
+    std::unordered_set<const IrValue*> visited;
+    bool opaque = false;
+    bool failed = false;
+};
+
+bool IsCandidate(const IrValue& value) {
+    return (value.HasImmediate() && value.Type() == IrType::U32) || value.Opcode() == IrOpcode::GetUserData;
+}
+
+void CollectLeaves(IrValue* value, std::optional<std::uint32_t> lane, std::uint32_t waveSize, Leaves& out) {
+    if (out.failed) return;
+    value = value->Resolve();
+    if (!out.visited.insert(value).second) return;
+    if (out.visited.size() > MaxLeafVisits) {
+        out.failed = true;
+        return;
+    }
+    if (value->IsPhi()) {
+        for (std::size_t index = 0; index < value->ArgumentCount(); ++index) CollectLeaves(value->Argument(index), lane, waveSize, out);
+        return;
+    }
+    if (value->Opcode() == IrOpcode::SelectU32) {
+        CollectLeaves(value->Argument(1), lane, waveSize, out);
+        CollectLeaves(value->Argument(2), lane, waveSize, out);
+        return;
+    }
+    if (lane.has_value() && value->Opcode() == IrOpcode::WriteLane) {
+        const IrValue* selector = value->Argument(1)->Resolve();
+        if (!selector->HasImmediate()) {
+            out.failed = true;
+            return;
+        }
+        if (selector->ImmediateU32() % waveSize == *lane) {
+            CollectLeaves(value->Argument(0), std::nullopt, waveSize, out);
+        } else {
+            CollectLeaves(value->Argument(2), lane, waveSize, out);
+        }
+        return;
+    }
+    if (!lane.has_value() && value->Opcode() == IrOpcode::ReadLane) {
+        const IrValue* selector = value->Argument(1)->Resolve();
+        if (selector->HasImmediate()) {
+            CollectLeaves(value->Argument(0), selector->ImmediateU32() % waveSize, waveSize, out);
+            return;
+        }
+    }
+    if (!lane.has_value() && IsCandidate(*value)) {
+        out.candidates.insert(value);
+        return;
+    }
+    if (!lane.has_value() && IsLoad(*value)) {
+        out.loads.insert(value);
+        return;
+    }
+    out.opaque = true;
+}
+
+std::optional<std::uint32_t> UserDataIndex(const IrValue& value) {
+    if (value.Opcode() != IrOpcode::GetUserData || value.ArgumentCount() == 0u || value.Argument(0) == nullptr) return std::nullopt;
+    return value.Argument(0)->Register().index;
+}
+
+std::optional<std::unordered_set<IrValue*>> Candidates(IrValue& pointer, std::uint32_t waveSize, bool& opaque) {
+    Leaves leaves;
+    CollectLeaves(&pointer, std::nullopt, waveSize, leaves);
+    if (leaves.failed) return std::nullopt;
+    opaque = opaque || leaves.opaque;
+    return std::move(leaves.candidates);
+}
+
+IrValue* UniqueUserData(const std::unordered_set<IrValue*>& candidates) {
+    IrValue* found = nullptr;
+    for (IrValue* candidate : candidates) {
+        if (!UserDataIndex(*candidate).has_value()) continue;
+        if (found != nullptr && UserDataIndex(*found) != UserDataIndex(*candidate)) return nullptr;
+        found = candidate;
+    }
+    return found;
+}
+
+IrValue* UniqueImmediate(const std::unordered_set<IrValue*>& candidates) {
+    IrValue* found = nullptr;
+    for (IrValue* candidate : candidates) {
+        if (!candidate->HasImmediate()) return nullptr;
+        if (found != nullptr && found->ImmediateU32() != candidate->ImmediateU32()) return nullptr;
+        found = candidate;
+    }
+    return found;
+}
+
+IrValue* GuessLow(IrValue& low, std::uint32_t waveSize, bool& opaque) {
+    if (IsCandidate(low)) return &low;
+    const auto candidates = Candidates(low, waveSize, opaque);
+    if (!candidates.has_value()) return nullptr;
+    if (IrValue* userData = UniqueUserData(*candidates)) return userData;
+    return UniqueImmediate(*candidates);
+}
+
+IrValue* GuessHigh(IrValue& high, const IrValue& low, std::uint32_t waveSize, bool& opaque) {
+    if (IsCandidate(high)) return &high;
+    const auto candidates = Candidates(high, waveSize, opaque);
+    if (!candidates.has_value()) return nullptr;
+    const auto lowIndex = UserDataIndex(low);
+    IrValue* zero = nullptr;
+    for (IrValue* candidate : *candidates) {
+        if (lowIndex.has_value() && UserDataIndex(*candidate) == *lowIndex + 1u) return candidate;
+        if (candidate->HasImmediate() && candidate->ImmediateU32() == 0u) zero = candidate;
+    }
+    if (zero != nullptr) return zero;
+    if (IrValue* userData = UniqueUserData(*candidates)) return userData;
+    return UniqueImmediate(*candidates);
+}
+
+bool FeedsDescriptor(const IrValue& address) {
+    for (const IrValue* load : address.Uses()) {
+        if (load->Opcode() != IrOpcode::LoadAddressU32) continue;
+        for (const IrValue* user : load->Uses()) {
+            const auto opcode = user->Opcode();
+            if (opcode == IrOpcode::GetImageResource || opcode == IrOpcode::GetSamplerResource || opcode == IrOpcode::GetBufferResource) return true;
+        }
+    }
+    return false;
+}
+
+std::uint32_t LoadPc(const IrValue& address) {
+    for (const IrValue* load : address.Uses()) {
+        if (load->Opcode() == IrOpcode::LoadAddressU32) return load->Flags<MemoryFlags>().pc;
+    }
+    return 0u;
+}
+
+class Dominance {
+public:
+    explicit Dominance(const IrProgram& program) {
+        const auto& order = program.BlockOrder();
+        if (order.empty()) return;
+        std::vector<const IrBlock*> post;
+        std::unordered_set<const IrBlock*> seen{order.front()};
+        std::vector<std::pair<const IrBlock*, std::size_t>> stack{{order.front(), 0u}};
+        while (!stack.empty()) {
+            auto& [block, next] = stack.back();
+            if (next < block->Successors().size()) {
+                const IrBlock* successor = block->Successors()[next++];
+                if (seen.insert(successor).second) stack.emplace_back(successor, 0u);
+                continue;
+            }
+            post.push_back(block);
+            stack.pop_back();
+        }
+        m_order.assign(post.rbegin(), post.rend());
+        for (std::size_t position = 0; position < m_order.size(); ++position) m_index[m_order[position]] = position;
+        m_idom.assign(m_order.size(), None);
+        m_idom[0] = 0;
+        for (bool changed = true; changed;) {
+            changed = false;
+            for (std::size_t position = 1; position < m_order.size(); ++position) {
+                std::size_t candidate = None;
+                for (const IrBlock* predecessor : m_order[position]->Predecessors()) {
+                    const auto found = m_index.find(predecessor);
+                    if (found == m_index.end() || m_idom[found->second] == None) continue;
+                    candidate = candidate == None ? found->second : Intersect(candidate, found->second);
+                }
+                if (candidate != m_idom[position]) {
+                    m_idom[position] = candidate;
+                    changed = true;
+                }
+            }
+        }
+    }
+
+    bool Dominates(const IrBlock* dominator, const IrBlock* block) const {
+        const auto from = m_index.find(dominator);
+        auto at = m_index.find(block);
+        if (from == m_index.end() || at == m_index.end()) return false;
+        for (std::size_t position = at->second;; position = m_idom[position]) {
+            if (position == from->second) return true;
+            if (position == 0u || m_idom[position] == None) return false;
+        }
+    }
+
+private:
+    static constexpr std::size_t None = static_cast<std::size_t>(-1);
+
+    std::size_t Intersect(std::size_t left, std::size_t right) const {
+        while (left != right) {
+            while (left > right) left = m_idom[left];
+            while (right > left) right = m_idom[right];
+        }
+        return left;
+    }
+
+    std::vector<const IrBlock*> m_order;
+    std::unordered_map<const IrBlock*, std::size_t> m_index;
+    std::vector<std::size_t> m_idom;
+};
+
+bool Available(const IrValue& value, const IrValue& user, const Dominance& dominance) {
+    if (value.HasImmediate() || value.Parent() == nullptr) return true;
+    if (value.Parent() != user.Parent()) return dominance.Dominates(value.Parent(), user.Parent());
+    for (const IrValue* inst : user.Parent()->Instructions()) {
+        if (inst == &value) return true;
+        if (inst == &user) return false;
+    }
+    return false;
+}
+
+IrValue& Insert(IrProgram& program, IrValue& position, IrOpcode opcode, IrType type, std::initializer_list<IrValue*> arguments) {
+    IrValue& value = program.CreateValue(opcode, type);
+    for (IrValue* argument : arguments) value.AddArgument(argument);
+    position.Parent()->InsertInstructionBefore(&position, &value);
+    return value;
+}
+
+IrValue* Rematerialize(IrProgram& program, IrValue& load, IrValue& user, const Dominance& dominance) {
+    if (Available(load, user, dominance)) return &load;
+    if (load.Opcode() != IrOpcode::LoadAddressU32 || load.ArgumentCount() != 4u) return nullptr;
+    IrValue* address = load.Argument(0)->Resolve();
+    if (address->Opcode() != IrOpcode::GetAddressResource || address->ArgumentCount() != 2u) return nullptr;
+    for (std::size_t index = 0; index < address->ArgumentCount(); ++index) {
+        if (!Available(*address->Argument(index)->Resolve(), user, dominance)) return nullptr;
+    }
+    for (std::size_t index = 1; index < load.ArgumentCount(); ++index) {
+        if (!Available(*load.Argument(index)->Resolve(), user, dominance)) return nullptr;
+    }
+    auto flags = load.Flags<MemoryFlags>();
+    auto& memory = program.Resources().memoryInfo;
+    if (flags.index >= memory.size()) return nullptr;
+    memory.push_back(memory[flags.index]);
+    flags.index = static_cast<std::uint32_t>(memory.size() - 1u);
+    IrValue& clone = Insert(program, user, IrOpcode::GetAddressResource, address->Type(), {address->Argument(0)->Resolve(), address->Argument(1)->Resolve()});
+    IrValue& read = program.CreateValue(IrOpcode::LoadAddressU32, load.Type());
+    read.SetFlags(flags);
+    read.AddArgument(&clone);
+    for (std::size_t index = 1; index < load.ArgumentCount(); ++index) read.AddArgument(load.Argument(index)->Resolve());
+    user.Parent()->InsertInstructionBefore(&user, &read);
+    return &read;
+}
+
+std::uint32_t LoadPcOf(const IrValue& load) {
+    return load.Opcode() == IrOpcode::LoadAddressU32 ? load.Flags<MemoryFlags>().pc : 0u;
+}
+
+std::optional<Leaves> DescriptorWordLeaves(IrValue& word, std::uint32_t waveSize) {
+    if (!word.IsPhi()) return std::nullopt;
+    Leaves leaves;
+    CollectLeaves(&word, std::nullopt, waveSize, leaves);
+    if (leaves.failed || leaves.loads.empty() || !leaves.opaque) return std::nullopt;
+    return leaves;
+}
+
+IrValue* PickLoad(const Leaves& leaves, std::optional<std::uint32_t> pc) {
+    if (leaves.loads.size() == 1u) return *leaves.loads.begin();
+    IrValue* latest = nullptr;
+    for (IrValue* load : leaves.loads) {
+        if (pc.has_value() && LoadPcOf(*load) == *pc) return load;
+        if (!pc.has_value() && (latest == nullptr || LoadPcOf(*load) > LoadPcOf(*latest))) latest = load;
+    }
+    return latest;
+}
+
+}
+
+DescriptorPointerSpeculationStats DescriptorPointerSpeculation::Speculate(IrProgram& program, std::uint32_t waveSize) const {
+    DescriptorPointerSpeculationStats stats;
+    IrBuilder builder(program);
+    std::vector<IrValue*> addresses;
+    for (const auto& block : program.Blocks()) {
+        for (IrValue* inst : block->Instructions()) {
+            if (inst->Opcode() == IrOpcode::GetAddressResource && inst->ArgumentCount() == 2u && FeedsDescriptor(*inst)) addresses.push_back(inst);
+        }
+    }
+    for (IrValue* address : addresses) {
+        std::array<IrValue*, 2> actual{address->Argument(0)->Resolve(), address->Argument(1)->Resolve()};
+        bool opaque = false;
+        IrValue* low = GuessLow(*actual[0], waveSize, opaque);
+        IrValue* high = low != nullptr ? GuessHigh(*actual[1], *low, waveSize, opaque) : nullptr;
+        if (low == nullptr || high == nullptr || !opaque || (low == actual[0] && high == actual[1])) continue;
+        const std::array<IrValue*, 2> guess{low, high};
+        IrValue* mismatch = nullptr;
+        for (std::size_t half = 0; half < 2u; ++half) {
+            if (guess[half] == actual[half]) continue;
+            IrValue& differs = Insert(program, *address, IrOpcode::INotEqual32, IrType::Bool, {actual[half], guess[half]});
+            mismatch = mismatch == nullptr ? &differs : &Insert(program, *address, IrOpcode::LogicalOr, IrType::Bool, {mismatch, &differs});
+        }
+        static_cast<void>(Insert(program, *address, IrOpcode::DescriptorFault, IrType::Void, {mismatch, actual[0], actual[1], &builder.Constant(LoadPc(*address))}));
+        for (std::size_t half = 0; half < 2u; ++half) address->ReplaceArgument(half, guess[half]);
+        program.Info().usesFaultBuffer = true;
+        ++stats.speculatedPointers;
+    }
+    const Dominance dominance(program);
+    std::vector<IrValue*> descriptors;
+    for (const auto& block : program.Blocks()) {
+        for (IrValue* inst : block->Instructions()) {
+            const auto opcode = inst->Opcode();
+            if (opcode == IrOpcode::GetImageResource || opcode == IrOpcode::GetSamplerResource || opcode == IrOpcode::GetBufferResource) descriptors.push_back(inst);
+        }
+    }
+    for (IrValue* descriptor : descriptors) {
+        std::vector<std::optional<Leaves>> words;
+        std::optional<std::uint32_t> pc;
+        bool agreed = true;
+        for (std::size_t dword = 0; dword < descriptor->ArgumentCount(); ++dword) {
+            words.push_back(DescriptorWordLeaves(*descriptor->Argument(dword)->Resolve(), waveSize));
+            if (!words.back().has_value() || words.back()->loads.size() != 1u) continue;
+            const auto loadPc = LoadPcOf(**words.back()->loads.begin());
+            if (pc.has_value() && *pc != loadPc) agreed = false;
+            pc = loadPc;
+        }
+        if (!agreed) pc.reset();
+        IrValue* mismatch = nullptr;
+        std::vector<std::pair<std::size_t, IrValue*>> replacements;
+        for (std::size_t dword = 0; dword < descriptor->ArgumentCount(); ++dword) {
+            if (!words[dword].has_value()) continue;
+            IrValue* actual = descriptor->Argument(dword)->Resolve();
+            IrValue* picked = PickLoad(*words[dword], pc);
+            IrValue* guess = picked != nullptr ? Rematerialize(program, *picked, *descriptor, dominance) : nullptr;
+            if (guess == nullptr) continue;
+            IrValue& differs = Insert(program, *descriptor, IrOpcode::INotEqual32, IrType::Bool, {actual, guess});
+            mismatch = mismatch == nullptr ? &differs : &Insert(program, *descriptor, IrOpcode::LogicalOr, IrType::Bool, {mismatch, &differs});
+            replacements.emplace_back(dword, guess);
+        }
+        if (mismatch == nullptr) continue;
+        const std::uint32_t faultPc = LoadPcOf(*replacements.front().second);
+        static_cast<void>(Insert(program, *descriptor, IrOpcode::DescriptorFault, IrType::Void, {mismatch, &builder.Constant(0u), &builder.Constant(0u), &builder.Constant(faultPc)}));
+        for (const auto& [dword, guess] : replacements) descriptor->ReplaceArgument(dword, guess);
+        program.Info().usesFaultBuffer = true;
+        ++stats.speculatedDescriptors;
+    }
+    return stats;
+}
+
+}
