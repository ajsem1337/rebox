diff --git a/core/libs/prx/libSceAgcDriver/tests/execution/DescriptorSpeculation.cpp b/core/libs/prx/libSceAgcDriver/tests/execution/DescriptorSpeculation.cpp
new file mode 100644
index 0000000000..96b68901de
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/tests/execution/DescriptorSpeculation.cpp
@@ -0,0 +1,176 @@
+#include "prx/libSceAgcDriver/Execution/include/VulkanDevice.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/Draw.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/Texture.hpp"
+#include "prx/libc/include/GuestAllocations.hpp"
+#include "Recompiler.hpp"
+#include "VulkanTestDevice.hpp"
+#include "tests/TemporaryFile.hpp"
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <span>
+#include <string>
+#include <string_view>
+#ifdef _WIN32
+#include <io.h>
+#else
+#include <unistd.h>
+#endif
+
+namespace {
+
+using AgcDriver::Graphics::Require;
+using ShaderRecompiler::ShaderStage;
+
+constexpr std::uint32_t Width = 32;
+constexpr std::uint32_t Format32x4Uint = 75;
+constexpr std::uint32_t Type1D = 8;
+constexpr std::size_t BlockBytes = 65536;
+alignas(256) std::array<std::uint32_t, 8> Table{};
+
+class GuestBlock {
+public:
+    GuestBlock() : block(static_cast<std::uint32_t*>(std::aligned_alloc(BlockBytes, BlockBytes))) {
+        Require(block != nullptr, "descriptor speculation: cannot allocate the guest block");
+        GuestAllocations::Mutation().Add(block, BlockBytes, true, true, true);
+    }
+
+    ~GuestBlock() {
+        GuestAllocations::Mutation().Remove(block);
+        std::free(block);
+    }
+
+    GuestBlock(const GuestBlock&) = delete;
+    GuestBlock& operator=(const GuestBlock&) = delete;
+
+    std::span<std::uint32_t> Texels() const { return {block, Width * 4u}; }
+
+private:
+    std::uint32_t* block;
+};
+
+alignas(256) constexpr std::array<std::uint32_t, 16> SkippedClobber{
+    0xbe940300u, 0xbe950301u, 0xbf068002u, 0xbf850002u, 0x7d880083u, 0xbe94036au, 0xf40c020au, 0xfa000000u,
+    0x7e020300u, 0x7e040300u, 0x7e060300u, 0x7e080300u, 0xbf8cc07fu, 0xf0201f00u, 0x00020100u, 0xbf810000u,
+};
+
+alignas(256) constexpr std::array<std::uint32_t, 16> TakenClobber{
+    0xbe940300u, 0xbe950301u, 0xbf068702u, 0xbf850002u, 0x7d880083u, 0xbe94036au, 0xf40c020au, 0xfa000000u,
+    0x7e020300u, 0x7e040300u, 0x7e060300u, 0x7e080300u, 0xbf8cc07fu, 0xf0201f00u, 0x00020100u, 0xbf810000u,
+};
+
+class StderrCapture {
+public:
+    StderrCapture() {
+        std::fflush(stderr);
+        file = TemporaryFile::Open();
+        Require(file != nullptr, "cannot open a temporary file for stderr");
+#ifdef _WIN32
+        saved = _dup(_fileno(stderr));
+        _dup2(_fileno(file), _fileno(stderr));
+#else
+        saved = dup(fileno(stderr));
+        dup2(fileno(file), fileno(stderr));
+#endif
+    }
+    std::string Finish() {
+        std::fflush(stderr);
+#ifdef _WIN32
+        _dup2(saved, _fileno(stderr));
+        _close(saved);
+#else
+        dup2(saved, fileno(stderr));
+        close(saved);
+#endif
+        std::rewind(file);
+        std::string text;
+        char buffer[4096];
+        for (std::size_t read = 0; (read = std::fread(buffer, 1, sizeof(buffer), file)) != 0;) text.append(buffer, read);
+        std::fclose(file);
+        std::fwrite(text.data(), 1, text.size(), stderr);
+        return text;
+    }
+
+private:
+    std::FILE* file = nullptr;
+    int saved = -1;
+};
+
+std::string Run(AgcDriver::VulkanDevice& device, std::span<const std::uint32_t> code, std::span<std::uint32_t> texels) {
+    std::ranges::fill(texels, 0xdeadbeefu);
+    const auto texelAddress = static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(texels.data()));
+    Table = {
+        static_cast<std::uint32_t>(texelAddress >> 8u),
+        static_cast<std::uint32_t>((texelAddress >> 40u) & 0xffu) | (Format32x4Uint << 20u) | (((Width - 1u) & 3u) << 30u),
+        (Width - 1u) >> 2u,
+        0xfacu | (Type1D << 28u),
+        0u, 0u, 0u, 0u,
+    };
+    const auto tableAddress = reinterpret_cast<std::uintptr_t>(Table.data());
+    const std::array<std::uint32_t, 2> userData{static_cast<std::uint32_t>(tableAddress), static_cast<std::uint32_t>(tableAddress >> 32u)};
+    const std::array<ShaderRecompiler::MemoryRegion, 2> memory{{
+        {reinterpret_cast<std::uintptr_t>(code.data()), std::as_bytes(code)},
+        {tableAddress, std::as_bytes(std::span<const std::uint32_t>(Table))},
+    }};
+    const ShaderRecompiler::ShaderComputeStageInfo compute{{Width, 1, 1}, 0u, {true, false, false}, false, 1};
+    ShaderRecompiler::RecompileRequest request{
+        {ShaderStage::Compute, reinterpret_cast<std::uintptr_t>(code.data()), code, 0, {}},
+        {32, 0, userData, compute, std::nullopt, std::nullopt, memory},
+        device.Target(),
+        {0, 0, 0, 128}
+    };
+    request.useCache = false;
+    const auto result = ShaderRecompiler::Recompile(request);
+    Require(result.descriptorFaults != 0u, "descriptor speculation: the speculated table pointer has no runtime check");
+    StderrCapture log;
+    try {
+        device.Dispatch(result, 1, 1, 1, {}, reinterpret_cast<std::uintptr_t>(code.data()));
+        device.WaitIdle();
+        AgcDriver::Graphics::StorageTexture::FlushPending(texelAddress, texels.size_bytes(), nullptr, "test");
+        device.WaitIdle();
+    } catch (...) {
+        static_cast<void>(log.Finish());
+        throw;
+    }
+    return log.Finish();
+}
+
+bool Faulted(const std::string& log) {
+    return log.find("BDA access failed") != std::string::npos && log.find("instruction=0x18") != std::string::npos && log.find("reason=8") != std::string::npos;
+}
+
+}
+
+int main() {
+    try {
+    #ifdef _WIN32
+    _putenv_s("APS5_SPECULATE_DESCRIPTORS", "1");
+#else
+    setenv("APS5_SPECULATE_DESCRIPTORS", "1", 1);
+#endif
+        const auto device = OpenVulkanTestDevice();
+        if (!device) return VulkanTestSkipped;
+        GuestBlock block;
+        const auto texels = block.Texels();
+        const auto skipped = Run(*device, SkippedClobber, texels);
+        Require(!Faulted(skipped), "descriptor speculation: the guessed table pointer faulted although the guess was right:\n" + skipped);
+        for (std::uint32_t x = 0; x < Width; ++x) {
+            for (std::uint32_t component = 0; component < 4u; ++component) {
+                const auto actual = texels[x * 4u + component];
+                Require(actual == x, "descriptor speculation: texel " + std::to_string(x) + " component " + std::to_string(component) + " is " + std::to_string(actual) + ", expected " + std::to_string(x));
+            }
+        }
+        const auto taken = Run(*device, TakenClobber, texels);
+        Require(Faulted(taken), "descriptor speculation: a wrong guess was not reported as an invalid descriptor at the load:\n" + taken);
+        std::puts("descriptor speculation runs the guessed table and reports a wrong guess");
+        return 0;
+    } catch (const std::exception& error) {
+        const std::string message = error.what();
+        std::cerr << message.substr(0, message.find("\nRecompileRequest:")) << '\n';
+        return 1;
+    }
+}
