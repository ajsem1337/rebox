diff --git a/core/shader/recompiler/tests/RequestMemoryViewTests.cpp b/core/shader/recompiler/tests/RequestMemoryViewTests.cpp
new file mode 100644
index 0000000000..8cae2cc061
--- /dev/null
+++ b/core/shader/recompiler/tests/RequestMemoryViewTests.cpp
@@ -0,0 +1,109 @@
+#include "Optimization/RequestMemoryView.hpp"
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <span>
+#include <vector>
+
+using namespace ShaderRecompiler;
+
+namespace {
+
+void Require(bool condition, const char* message) {
+    if (!condition) {
+        std::fprintf(stderr, "Requirement failed: %s\n", message);
+        std::abort();
+    }
+}
+
+std::vector<std::byte> Bytes(std::size_t count, std::uint8_t first) {
+    std::vector<std::byte> bytes(count);
+    for (std::size_t index = 0; index < count; ++index) bytes[index] = static_cast<std::byte>(first + index);
+    return bytes;
+}
+
+bool ReadEach(const SrtRuntime& runtime, std::uint64_t address, std::uint64_t count, std::vector<std::uint32_t>& out) {
+    out.assign(count, 0u);
+    for (std::uint64_t word = 0; word < count; ++word) {
+        if (!runtime.readMemory(runtime.userContext, address + word * 4u, &out[word])) return false;
+    }
+    return true;
+}
+
+bool Inside(const std::vector<MemoryRegion>& regions, std::uint64_t address, std::uint64_t bytes) {
+    for (std::uint64_t at = address; at < address + bytes; ++at) {
+        bool found = false;
+        for (const auto& region : regions) found = found || (at >= region.guestAddress && at < region.guestAddress + region.bytes.size());
+        if (!found) return false;
+    }
+    return true;
+}
+
+void ReadsMatchWordByWord() {
+    const auto first = Bytes(16, 0x10);
+    const auto second = Bytes(18, 0x40);
+    const auto third = Bytes(8, 0x80);
+    const std::vector<MemoryRegion> regions{
+        {0x2000, std::span<const std::byte>(third)},
+        {0x1000, std::span<const std::byte>(first)},
+        {0x1010, std::span<const std::byte>(second)},
+    };
+    RequestMemoryView view{std::span<const MemoryRegion>(regions)};
+    const auto runtime = view.MakeRuntime({}, 0);
+    Require(runtime.readWords != nullptr, "the view reads runs of words");
+    const std::array<std::uint64_t, 12> starts{0x0ffc, 0x1000, 0x1004, 0x100c, 0x1010, 0x101c, 0x101e, 0x1020, 0x1ffc, 0x2000, 0x2004, 0x2008};
+    for (int pass = 0; pass < 2; ++pass) {
+        for (const auto start : starts) {
+            for (std::uint64_t count = 0; count <= 12u; ++count) {
+                std::vector<std::uint32_t> each;
+                const bool eachOk = ReadEach(runtime, start, count, each);
+                std::vector<std::uint32_t> run(count, 0u);
+                const bool runOk = runtime.readWords(runtime.userContext, start, run.data(), count);
+                Require(eachOk == runOk, "a run of words reads exactly when each word does");
+                if (eachOk) Require(each == run, "a run of words holds what each word does");
+            }
+        }
+    }
+    std::uint32_t word = 0;
+    Require(runtime.readMemory(runtime.userContext, 0x100c, &word), "the last word of a region reads");
+    std::uint32_t expected = 0;
+    std::memcpy(&expected, first.data() + 12, sizeof(expected));
+    Require(word == expected, "the last word of a region holds its bytes");
+    Require(!runtime.readMemory(runtime.userContext, 0x1020, &word), "a word straddling the end of a region fails");
+    Require(!runtime.readMemory(runtime.userContext, 0x1800, &word), "a word between regions fails");
+    Require(runtime.readMemory(runtime.userContext, 0x2004, &word), "a word after a gap reads");
+    Require(!runtime.readMemory(runtime.userContext, 0x1804, &word), "a gap read again fails");
+    Require(!runtime.readMemory(runtime.userContext, 0x0, &word), "a word before every region fails");
+    Require(!runtime.readMemory(runtime.userContext, 0x3000, &word), "a word after every region fails");
+}
+
+void CoverageMatchesBytes() {
+    const auto first = Bytes(16, 0x10);
+    const auto second = Bytes(16, 0x40);
+    const auto third = Bytes(8, 0x80);
+    const std::vector<MemoryRegion> regions{
+        {0x1000, std::span<const std::byte>(first)},
+        {0x1010, std::span<const std::byte>(second)},
+        {0x2000, std::span<const std::byte>(third)},
+    };
+    RequestMemoryView view{std::span<const MemoryRegion>(regions)};
+    const auto runtime = view.MakeRuntime({}, 0);
+    for (int pass = 0; pass < 2; ++pass) {
+        for (std::uint64_t address = 0x0ff8; address < 0x2010; address += address < 0x1028 || address >= 0x1ff0 ? 4u : 0x100u) {
+            for (std::uint64_t bytes = 1; bytes <= 40u; bytes += 3u) {
+                Require(runtime.accessible(runtime.userContext, address, bytes) == Inside(regions, address, bytes), "coverage matches the regions' bytes");
+            }
+        }
+    }
+}
+
+}
+
+int main() {
+    ReadsMatchWordByWord();
+    CoverageMatchesBytes();
+    std::puts("request memory view tests passed");
+    return 0;
+}
