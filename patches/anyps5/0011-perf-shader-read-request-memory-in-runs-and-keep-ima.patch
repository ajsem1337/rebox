-    std::memcpy(&word, region.bytes.data() + offset, sizeof(word));
+    std::memcpy(&word, region->bytes.data() + offset, sizeof(word));
     *value = word;
     return true;
 }
 
+bool RequestMemoryView::ReadGuestWords(void* userContext, std::uint64_t address, std::uint32_t* values, std::uint64_t count) {
+    const auto* self = static_cast<const RequestMemoryView*>(userContext);
+    while (count != 0u) {
+        const MemoryRegion* region = self->Find(address);
+        if (region == nullptr) return ReadGuestMemory(userContext, address, values);
+        const std::uint64_t offset = address - region->guestAddress;
+        const std::uint64_t whole = std::min<std::uint64_t>(count, (region->bytes.size() - offset) / sizeof(std::uint32_t));
+        if (whole == 0u) {
+            if (!ReadGuestMemory(userContext, address, values)) return false;
+            address += sizeof(std::uint32_t);
+            ++values;
+            --count;
+            continue;
+        }
+        std::memcpy(values, region->bytes.data() + offset, static_cast<std::size_t>(whole) * sizeof(std::uint32_t));
+        address += whole * sizeof(std::uint32_t);
+        values += whole;
+        count -= whole;
+    }
+    return true;
+}
