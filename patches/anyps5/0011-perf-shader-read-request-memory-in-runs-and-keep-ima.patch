+const MemoryRegion* RequestMemoryView::Find(std::uint64_t address) const {
+    if (regions.empty()) return nullptr;
+    const auto hint = last.load(std::memory_order_relaxed);
+    if (hint < regions.size() && address >= regions[hint].guestAddress && address - regions[hint].guestAddress < regions[hint].bytes.size()) return &regions[hint];
+    const auto gap = lastGap.load(std::memory_order_relaxed);
+    if (gap <= regions.size()) {
+        const std::uint64_t low = gap == 0u ? 0u : regions[gap - 1u].guestAddress + regions[gap - 1u].bytes.size();
+        const std::uint64_t high = gap == regions.size() ? std::numeric_limits<std::uint64_t>::max() : regions[gap].guestAddress;
+        if (address >= low && address < high) return nullptr;
+    }
+    const auto it = std::upper_bound(regions.begin(), regions.end(), address, [](std::uint64_t addressValue, const MemoryRegion& region) {
+        return addressValue < region.guestAddress;
+    });
+    if (it == regions.begin() || address - std::prev(it)->guestAddress >= std::prev(it)->bytes.size()) {
+        lastGap.store(static_cast<std::size_t>(it - regions.begin()), std::memory_order_relaxed);
+        return nullptr;
+    }
+    const auto found = std::prev(it);
+    last.store(static_cast<std::size_t>(found - regions.begin()), std::memory_order_relaxed);
+    return &*found;
+}
