-        return addressValue < region.guestAddress;
-    });
-    if (it == self->regions.begin()) {
-        return miss();
-    }
-    const MemoryRegion& region = *std::prev(it);
-    if (address < region.guestAddress) {
+    const MemoryRegion* region = self->Find(address);
