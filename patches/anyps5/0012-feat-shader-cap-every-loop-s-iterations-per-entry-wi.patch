     state.module.AddFunction(spv::OpStore, state.loopGuardPc, pc);
-    if (exitWhenTrue) return Binary(state, spv::OpLogicalOr, TypeBool(state), condition, tripped);
-    const auto stay = state.module.AllocateId();
