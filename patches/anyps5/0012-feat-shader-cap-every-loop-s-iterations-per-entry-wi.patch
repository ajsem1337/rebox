+
+using namespace ShaderRecompiler;
+
+namespace {
+
+void Require(bool condition, const char* message) {
+    if (!condition) {
+        std::fprintf(stderr, "Requirement failed: %s\n", message);
+        std::abort();
+    }
+}
+
+constexpr std::uint32_t Limit = 0x100000u;
+
+constexpr std::array<std::uint32_t, 5> EndlessLoop{
+    0xbe880381u,
+    0x80088108u,
+    0xbf078008u,
+    0xbf85fffdu,
+    0xbf810000u,
+};
+
+SpirvTarget Target() {
+    static constexpr std::array<std::uint32_t, 4> capabilities{spv::CapabilityInt64, spv::CapabilityPhysicalStorageBufferAddresses, spv::CapabilityGroupNonUniformBallot, spv::CapabilityGroupNonUniformVote};
+    static constexpr std::array<std::string_view, 1> extensions{"SPV_KHR_physical_storage_buffer"};
+    return {0x00402000u, 0x00010500u, 32u, BdaAbi::Version, capabilities, extensions, false, {1024, 1024, 64}, 1024, 65536, {}, {}};
+}
+
+RecompileResult CompileEndlessLoop() {
+    const ShaderComputeStageInfo compute{{1u, 1u, 1u}, 0u, {false, false, false}, false, 1u};
+    const std::vector<MemoryRegion> regions;
+    RecompileRequest request{
+        {ShaderStage::Compute, 0x10000000u, std::span<const std::uint32_t>(EndlessLoop), 0, {}},
+        {32u, 0, {}, compute, std::nullopt, std::nullopt, MemoryRegionView(std::span<const MemoryRegion>(regions)), ShaderFloatMode{}},
+        Target(),
+        {0, 0, 0, 128},
+    };
+    request.useCache = false;
+    return Recompile(request);
+}
+
+struct Instruction {
+    spv::Op op;
+    std::span<const std::uint32_t> operands;
+};
+
+std::vector<Instruction> Instructions(std::span<const std::uint32_t> words) {
+    std::vector<Instruction> instructions;
+    for (std::size_t index = 5; index < words.size();) {
+        const auto count = words[index] >> 16u;
+        Require(count != 0u && index + count <= words.size(), "the module's instructions are well formed");
+        instructions.push_back({static_cast<spv::Op>(words[index] & 0xffffu), words.subspan(index + 1u, count - 1u)});
+        index += count;
+    }
+    return instructions;
+}
+
+void TestEndlessLoopLeavesAtTheLimit() {
+    Require(LoopGuardLimit() == Limit, "APS5_LOOP_GUARD is read as the limit");
+    const auto result = CompileEndlessLoop();
+    const auto view = result.spirv.Words();
+    const std::vector<std::uint32_t> words(view.begin(), view.end());
+
+    std::string log;
+    spvtools::SpirvTools tools(SPV_ENV_VULKAN_1_2);
+    tools.SetMessageConsumer([&](spv_message_level_t, const char*, const spv_position_t&, const char* message) { log += message; });
+    spvtools::ValidatorOptions options;
+    options.SetScalarBlockLayout(true);
+    if (!tools.Validate(words.data(), words.size(), options)) std::fprintf(stderr, "%s\n", log.c_str());
+    Require(tools.Validate(words.data(), words.size(), options), "the guarded loop validates");
+
+    Require(std::ranges::any_of(result.bindings, [](const auto& binding) { return binding.role == DescriptorRole::FaultBuffer; }), "a program with a guarded loop binds the fault buffer");
+
+    const auto instructions = Instructions(words);
+    std::vector<std::uint32_t> merges;
+    std::vector<std::uint32_t> limitConstants;
+    for (const auto& instruction : instructions) {
+        if (instruction.op == spv::OpLoopMerge) merges.push_back(instruction.operands[0]);
+        if (instruction.op == spv::OpConstant && instruction.operands.size() == 3u && instruction.operands[2] == Limit) limitConstants.push_back(instruction.operands[1]);
+    }
+    Require(!merges.empty(), "the endless loop is a structured loop");
+    Require(!limitConstants.empty(), "the limit is a constant of the module");
+    for (const auto merge : merges) {
+        Require(std::ranges::any_of(instructions, [&](const Instruction& instruction) {
+            return instruction.op == spv::OpBranchConditional && (instruction.operands[1] == merge || instruction.operands[2] == merge);
+        }), "every loop has a conditional exit to its merge block");
+    }
+    Require(std::ranges::any_of(instructions, [&](const Instruction& instruction) {
+        return instruction.op == spv::OpUGreaterThanEqual && std::ranges::find(limitConstants, instruction.operands[3]) != limitConstants.end();
+    }), "an iteration count is compared with the limit");
+    Require(std::ranges::any_of(instructions, [&](const Instruction& instruction) {
+        return instruction.op == spv::OpFunctionCall && instruction.operands.size() > 3u && instruction.operands[3] == [&] {
+            for (const auto& constant : instructions) {
+                if (constant.op == spv::OpConstant && constant.operands.size() == 3u && constant.operands[2] == static_cast<std::uint32_t>(BdaAbi::FaultReason::LoopLimit)) return constant.operands[1];
+            }
+            return 0u;
+        }();
+    }), "a loop the guard stopped records a LoopLimit fault");
+}
+
+}
+
+int main() {
+#ifdef _WIN32
+    _putenv("APS5_LOOP_GUARD=0x100000");
+#else
+    setenv("APS5_LOOP_GUARD", "0x100000", 1);
+#endif
+    try {
+        TestEndlessLoopLeavesAtTheLimit();
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+    std::puts("loop guard tests passed");
+    return 0;
+}
