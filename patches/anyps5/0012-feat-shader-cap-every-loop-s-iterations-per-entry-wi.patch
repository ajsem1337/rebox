+void DefineLoopGuard(SpirvEmitterState& state, const IrProgram& program) {
+    const auto pointer = TypePointer(state, spv::StorageClassPrivate, TypeU32(state));
+    if (state.loopGuardPc == 0) state.loopGuardPc = state.module.DefineGlobalVariable(pointer, spv::StorageClassPrivate);
+    state.module.AddFunction(spv::OpStore, state.loopGuardPc, ConstantU32(state, 0u));
+    state.loopGuardCounters.clear();
+    for (const auto& info : program.Metadata().blockInfo) {
+        const Terminator& term = info.terminator;
+        if (!term.loopHeader || term.mergeBlock == InvalidControlFlowId || term.continueBlock == InvalidControlFlowId) continue;
+        SpirvEmitterState::LoopGuardCounter counter;
+        counter.header = info.id;
+        counter.merge = term.mergeBlock;
+        counter.continueBlock = term.continueBlock;
+        counter.variable = state.module.DefineGlobalVariable(pointer, spv::StorageClassPrivate);
+        state.module.AddFunction(spv::OpStore, counter.variable, ConstantU32(state, 0u));
+        state.loopGuardCounters.push_back(counter);
+    }
+}
+
+void CountLoopGuardEdges(SpirvEmitterState& state, const BlockInfo& info) {
+    if (state.loopGuardLimit == 0) return;
+    const Terminator& term = info.terminator;
+    for (const auto& counter : state.loopGuardCounters) {
+        if (counter.continueBlock == info.id) {
+            const auto count = state.module.AllocateId();
+            state.module.AddFunction(spv::OpLoad, TypeU32(state), count, counter.variable);
+            state.module.AddFunction(spv::OpStore, counter.variable, EmitBinaryU32(state, spv::OpIAdd, count, ConstantU32(state, 1u)));
+        } else if (counter.header == term.trueBlock || (term.kind == TerminatorKind::ConditionalBranch && counter.header == term.falseBlock)) {
+            state.module.AddFunction(spv::OpStore, counter.variable, ConstantU32(state, 0u));
+        }
+    }
+}
+
+const SpirvEmitterState::LoopGuardCounter* LoopGuardFor(const SpirvEmitterState& state, std::uint32_t merge) {
+    for (const auto& counter : state.loopGuardCounters) {
+        if (counter.merge == merge) return &counter;
+    }
+    return nullptr;
+}
+
