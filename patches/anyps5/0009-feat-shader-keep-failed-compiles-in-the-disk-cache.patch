+std::vector<std::byte> EncodeFailureEntry(std::span<const std::byte> key, std::uint64_t codeAddress, std::string_view message) {
+    std::vector<std::byte> payload;
+    Writer writer(payload);
+    writer.Value(codeAddress);
+    writer.Text(std::string(message));
+    return wrapEntry(key, payload, FailureMagic);
+}
+
+LoadStatus DecodeFailureEntry(std::span<const std::byte> file, std::span<const std::byte> key, std::uint64_t codeAddress, std::string& message) {
+    std::span<const std::byte> payload;
+    const auto status = unwrapEntry(file, key, payload);
+    if (status == LoadStatus::Loaded) return LoadStatus::Absent;
+    if (status != LoadStatus::Failed) return status;
+    Reader reader(payload);
+    std::uint64_t recordedAddress = 0;
+    std::string recordedMessage;
+    reader.Value(recordedAddress);
+    reader.Text(recordedMessage);
+    if (!reader.Done()) return LoadStatus::Rejected;
+    if (recordedAddress != codeAddress) return LoadStatus::KeyMismatch;
+    message = std::move(recordedMessage);
+    return LoadStatus::Failed;
+}
