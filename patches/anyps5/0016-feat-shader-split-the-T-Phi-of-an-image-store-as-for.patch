@@ -1178,6 +1178,10 @@ private:
     static constexpr std::uint32_t phiSearchDepth = 8u;
     static constexpr std::uint32_t firstLaneMultipleDepth = 32u;
 
+    static bool SplittableImageWrite(const IrValue& inst) {
+        return inst.Opcode() == IrOpcode::ImageWrite && inst.ArgumentCount() == 4u;
+    }
+
     static bool SplittableImageRead(const IrValue& inst) {
         switch (inst.Opcode()) {
             case IrOpcode::ImageSampleRaw:
@@ -1500,8 +1504,29 @@ private:
         }
         std::vector<std::array<IrValue*, 3>> armWords;
         const auto memory = m_program.Resources().memoryInfo.at(flags.index);
+        const bool write = inst.Type() == IrType::Void;
+        std::vector<IrValue*> taken;
+        if (write) {
+            IrValue* untaken = nullptr;
+            for (std::uint32_t arm = 0; arm <= conditions.size(); arm++) {
+                if (arm == conditions.size()) {
+                    taken.push_back(untaken);
+                    break;
+                }
+                const std::array<IrValue*, 2> both {untaken, conditions[arm]};
+                taken.push_back(untaken == nullptr ? conditions[arm] : EmitBefore(inst, IrOpcode::LogicalAnd, IrType::Bool, both));
+                const std::array<IrValue*, 1> negated {conditions[arm]};
+                IrValue* other = EmitBefore(inst, IrOpcode::LogicalNot, IrType::Bool, negated);
+                const std::array<IrValue*, 2> rest {untaken, other};
+                untaken = untaken == nullptr ? other : EmitBefore(inst, IrOpcode::LogicalAnd, IrType::Bool, rest);
+            }
+        }
         for (std::uint32_t arm = 0; arm <= conditions.size(); arm++) {
             std::vector<IrValue*> arguments(inst.Arguments().begin(), inst.Arguments().end());
+            if (write && taken[arm] != nullptr) {
+                const std::array<IrValue*, 2> active {arguments.back(), taken[arm]};
+                arguments.back() = EmitBefore(inst, IrOpcode::LogicalAnd, IrType::Bool, active);
+            }
             for (std::uint32_t slot = 0; slot < handleCount; slot++) {
                 if (!split[slot]) {
                     continue;
@@ -1536,6 +1561,11 @@ private:
             EmitDescriptorFault(inst, UndefinedImageWords(inst, selected), *selected[0], *selected[1]);
         }
 
+        if (write) {
+            inst.Invalidate();
+            inst.Parent()->RemoveInstruction(&inst);
+            return;
+        }
         IrValue* result = copies.back();
         if (copies.size() > 1u) {
             std::array<IrValue*, 4> components {};
@@ -1876,7 +1906,7 @@ private:
         std::vector<IrValue*> candidates;
         for (auto& block : m_program.Blocks()) {
             for (IrValue* inst : block->Instructions()) {
-                if (SplittableImageRead(*inst)) {
+                if (SplittableImageRead(*inst) || SplittableImageWrite(*inst)) {
                     candidates.push_back(inst);
                 }
             }
