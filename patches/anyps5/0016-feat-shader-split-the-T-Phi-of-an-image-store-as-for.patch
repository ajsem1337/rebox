 std::array<std::uint32_t, 8> ImageDescriptor(std::uint32_t entry) {
     std::array<std::uint32_t, 8> words{};
     words[0] = (0x40000000u + entry * 0x10000u) >> 8u;
@@ -101,6 +106,17 @@ std::vector<std::uint32_t> ValidWords(const RecompileResult& result, const char*
     return words;
 }
 
+std::size_t CountOps(std::span<const std::uint32_t> words, spv::Op op) {
+    std::size_t count = 0;
+    for (std::size_t index = 5; index < words.size();) {
+        const auto length = words[index] >> 16u;
+        Require(length != 0u && index + length <= words.size(), "the module's instructions are well formed");
+        count += static_cast<spv::Op>(words[index] & 0xffffu) == op;
+        index += length;
+    }
+    return count;
+}
+
 void TestWaterfallReadsAnImageTable() {
     const auto result = Compile(WaterfallShader, TableAddress);
     ValidWords(result, "the waterfall module validates");
@@ -108,11 +124,18 @@ void TestWaterfallReadsAnImageTable() {
             "a T# loaded at a first-lane offset inside a waterfall loop is read through an image table");
 }
 
+void TestBranchSelectedStoreIsSplit() {
+    const auto result = Compile(BranchStoreShader, TableAddress);
+    const auto words = ValidWords(result, "the branch-selected store module validates");
+    Require(CountOps(words, spv::OpImageWrite) == 2u, "a store through a branch-selected T# becomes one store per T#");
+}
+
 }
 
