From 0fd36d16152e756eb7231997d6d47e560134d6fd Mon Sep 17 00:00:00 2001
From: Brian McKenna <brian@brianmckenna.org>
Date: Sat, 21 Nov 2026 00:19:25 +0000
Subject: [PATCH] fix(shader): decode MIMG resource descriptors that end in VCC

An 8-dword T# loaded into s[100:107], or a 4-dword one into s[104:107],
ends in scalar operand codes 106-107, VCC_LO and VCC_HI, which
scalarSource already decodes. MUBUF and MTBUF accept such a descriptor
since c8d44e651e; MIMG refused anything past s105.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../tests/ImageResourceVcc.cpp                | 47 +++++++++++++++++++
 .../cmake/agc_image_resource_vcc_tests.cmake  | 14 ++++++
 .../RdnaDecoder/src/RdnaImageOpDecoder.cpp    |  2 +-
 3 files changed, 62 insertions(+), 1 deletion(-)
 create mode 100644 core/libs/prx/libSceAgcDriver/tests/ImageResourceVcc.cpp
 create mode 100644 core/libs/prx/libSceAgcDriver/tests/cmake/agc_image_resource_vcc_tests.cmake

diff --git a/core/libs/prx/libSceAgcDriver/tests/ImageResourceVcc.cpp b/core/libs/prx/libSceAgcDriver/tests/ImageResourceVcc.cpp
new file mode 100644
index 0000000000..9331928f54
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/tests/ImageResourceVcc.cpp
@@ -0,0 +1,47 @@
+#include "RdnaDecoder/RdnaImageOpDecoder.hpp"
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <stdexcept>
+#include <string_view>
+
+using namespace ShaderRecompiler;
+
+int main() {
+    try {
+        constexpr std::uint32_t ImageLoad = 0xf0001f08u;
+        constexpr std::uint32_t ImageSample = 0xf0800f08u;
+        constexpr std::uint32_t R128 = 0x8000u;
+        for (const auto first : {ImageLoad, ImageSample, ImageLoad | R128, ImageSample | R128}) {
+            const bool r128 = (first & R128) != 0u;
+            const auto decode = [&](std::uint32_t resource) {
+                const std::array<std::uint32_t, 2> code{first, (26u << 21u) | (resource << 16u) | (16u << 8u) | 4u};
+                return DecodeRdnaMimg(0x100u, code, 0u);
+            };
+            const std::uint32_t last = r128 ? 26u : 25u;
+            for (std::uint32_t resource = 0u; resource <= last; ++resource) {
+                const auto instruction = decode(resource);
+                if (instruction.programCounter != 0x100u || instruction.sourceCount != 3u ||
+                    instruction.source1.kind != RdnaOperandKind::ScalarRegister || instruction.source1.reg != resource * 4u ||
+                    instruction.source2.kind != RdnaOperandKind::ScalarRegister || instruction.source2.reg != 104u ||
+                    instruction.source0.kind != RdnaOperandKind::VectorRegister || instruction.source0.reg != 4u ||
+                    instruction.destination.kind != RdnaOperandKind::VectorRegister || instruction.destination.reg != 16u ||
+                    instruction.imageR128 != r128)
+                    throw std::runtime_error("image descriptor decode changed another operand");
+            }
+            for (std::uint32_t resource = last + 1u; resource < 32u; ++resource) {
+                bool refused = false;
+                try { static_cast<void>(decode(resource)); }
+                catch (const std::runtime_error& error) {
+                    refused = std::string_view(error.what()) == "MIMG descriptor register range overflow";
+                }
+                if (!refused) throw std::runtime_error("image descriptor extends past the VCC tuple");
+            }
+        }
+        std::puts("MIMG mixed SGPR/VCC descriptors and out-of-range refusals pass");
+        return 0;
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+}
diff --git a/core/libs/prx/libSceAgcDriver/tests/cmake/agc_image_resource_vcc_tests.cmake b/core/libs/prx/libSceAgcDriver/tests/cmake/agc_image_resource_vcc_tests.cmake
new file mode 100644
index 0000000000..f200e82f84
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/tests/cmake/agc_image_resource_vcc_tests.cmake
@@ -0,0 +1,14 @@
+add_test_executable(agc_image_resource_vcc_tests EXCLUDE_FROM_ALL tests/ImageResourceVcc.cpp)
+target_link_libraries(agc_image_resource_vcc_tests PRIVATE shader_recompiler_agc_driver libc)
+set_target_properties(agc_image_resource_vcc_tests PROPERTIES CXX_EXTENSIONS OFF)
+configure_windows_unwind(agc_image_resource_vcc_tests)
+
+if(BUILD_TESTING)
+    set_target_properties(agc_image_resource_vcc_tests PROPERTIES EXCLUDE_FROM_ALL OFF)
+    add_test(NAME agc_image_resource_vcc COMMAND agc_image_resource_vcc_tests)
+    set_tests_properties(agc_image_resource_vcc PROPERTIES TIMEOUT 30)
+    if(WIN32)
+        set_tests_properties(agc_image_resource_vcc PROPERTIES ENVIRONMENT_MODIFICATION
+            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
+    endif()
+endif()
diff --git a/core/shader/recompiler/RdnaDecoder/src/RdnaImageOpDecoder.cpp b/core/shader/recompiler/RdnaDecoder/src/RdnaImageOpDecoder.cpp
index a604e5a5ca..5282a8c029 100644
--- a/core/shader/recompiler/RdnaDecoder/src/RdnaImageOpDecoder.cpp
+++ b/core/shader/recompiler/RdnaDecoder/src/RdnaImageOpDecoder.cpp
@@ -420,7 +420,7 @@ RdnaInstruction DecodeRdnaMimg(std::uint32_t programCounter, std::span<const std
     const auto resource = ((word1 >> 16u) & 31u) * 4u;
     const auto sampler = ((word1 >> 21u) & 31u) * 4u;
     const bool r128 = (word0 & 0x8000u) != 0u;
-    if (resource + (r128 ? 4u : 8u) > 106u || ((info.sample || info.gather || opcode == 0x60u) && sampler > 104u)) {
+    if (resource + (r128 ? 4u : 8u) > 108u || ((info.sample || info.gather || opcode == 0x60u) && sampler > 104u)) {
         throw std::runtime_error("MIMG descriptor register range overflow");
     }
     RdnaInstruction instruction{};
