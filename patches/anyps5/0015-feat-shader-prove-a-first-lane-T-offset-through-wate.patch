+#include "BdaAbi.hpp"
+#include "Recompiler.hpp"
+#include <spirv-tools/libspirv.hpp>
+#include <spirv/unified1/spirv.hpp>
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+using namespace ShaderRecompiler;
+
+namespace {
+
+void Require(bool condition, const char* message) {
+    if (!condition) {
+        std::fprintf(stderr, "Requirement failed: %s\n", message);
+        std::abort();
+    }
+}
+
+constexpr std::uint32_t TableAddress = 0x20000000u;
+constexpr std::uint32_t OutputAddress = 0x30000000u;
+constexpr std::uint32_t TableEntries = 64u;
+
+constexpr std::array<std::uint32_t, 20> WaterfallShader{
+    0xbe850380u, 0xbe86037eu, 0x7daa0080u, 0xbf88000fu, 0x34020085u, 0xbe87037eu,
+    0x7e100501u, 0x7da40208u, 0xf40c0202u, 0x10000000u, 0xbf8cc07fu, 0xf0001f00u, 0x00020200u, 0xbe874707u, 0xbf89fff7u,
+    0xbefe0306u, 0xbf8c3f70u, 0xe0701000u, 0x80040200u, 0xbf810000u,
+};
+
+std::array<std::uint32_t, 8> ImageDescriptor(std::uint32_t entry) {
+    std::array<std::uint32_t, 8> words{};
+    words[0] = (0x40000000u + entry * 0x10000u) >> 8u;
+    words[1] = 56u << 20u;
+    words[2] = 63u;
+    words[3] = 0xfacu | (8u << 28u);
+    return words;
+}
+
+std::vector<std::uint32_t> Table() {
+    std::vector<std::uint32_t> table(TableEntries * 8u);
+    for (std::uint32_t entry = 0; entry < TableEntries; entry++) {
+        const auto words = ImageDescriptor(entry);
+        std::copy(words.begin(), words.end(), table.begin() + entry * 8u);
+    }
+    return table;
+}
+
+std::array<std::uint32_t, 20> UserData(std::uint32_t table) {
+    std::array<std::uint32_t, 20> user{};
+    user[4] = table;
+    user[16] = OutputAddress;
+    user[18] = 1024u;
+    user[19] = 0xfacu | (77u << 12u);
+    return user;
+}
+
+SpirvTarget Target() {
+    static constexpr std::array<std::uint32_t, 8> capabilities{spv::CapabilityInt64, spv::CapabilityPhysicalStorageBufferAddresses, spv::CapabilityImageQuery, spv::CapabilitySampled1D,
+                                                               spv::CapabilityImage1D, spv::CapabilityStorageImageWriteWithoutFormat, spv::CapabilityGroupNonUniformBallot, spv::CapabilityGroupNonUniformVote};
+    static constexpr std::array<std::string_view, 1> extensions{"SPV_KHR_physical_storage_buffer"};
+    return {0x00402000u, 0x00010500u, 32u, BdaAbi::Version, capabilities, extensions, false, {1024, 1024, 64}, 1024, 65536, {}, {}};
+}
+
+RecompileResult Compile(std::span<const std::uint32_t> code, std::uint32_t table) {
+    static const auto entries = Table();
+    static std::array<std::byte, 64u * 1024u> output{};
+    const auto user = UserData(table);
+    const std::vector<MemoryRegion> regions{{TableAddress, std::as_bytes(std::span<const std::uint32_t>(entries))}, {OutputAddress, std::span<const std::byte>(output)}};
+    const ShaderComputeStageInfo compute{{32u, 1u, 1u}, 0u, {false, false, false}, false, 1u};
+    RecompileRequest request{
+        {ShaderStage::Compute, 0x10000000u, code, 0, {}},
+        {32u, 0, std::span<const std::uint32_t>(user), compute, std::nullopt, std::nullopt, MemoryRegionView(std::span<const MemoryRegion>(regions)), ShaderFloatMode{}},
+        Target(),
+        {0, 0, 0, 128},
+    };
+    request.useCache = false;
+    return Recompile(request);
+}
+
+std::vector<std::uint32_t> ValidWords(const RecompileResult& result, const char* what) {
+    const auto view = result.spirv.Words();
+    std::vector<std::uint32_t> words(view.begin(), view.end());
+    std::string log;
+    spvtools::SpirvTools tools(SPV_ENV_VULKAN_1_2);
+    tools.SetMessageConsumer([&](spv_message_level_t, const char*, const spv_position_t&, const char* message) { log += message; });
+    spvtools::ValidatorOptions options;
+    options.SetScalarBlockLayout(true);
+    const bool valid = tools.Validate(words.data(), words.size(), options);
+    if (!valid) std::fprintf(stderr, "%s\n", log.c_str());
+    Require(valid, what);
+    return words;
+}
+
+void TestWaterfallReadsAnImageTable() {
+    const auto result = Compile(WaterfallShader, TableAddress);
+    ValidWords(result, "the waterfall module validates");
+    Require(std::ranges::any_of(result.bindings, [](const auto& binding) { return binding.role == DescriptorRole::ImageTable; }),
+            "a T# loaded at a first-lane offset inside a waterfall loop is read through an image table");
+}
+
+}
+
+int main() {
+    try {
+        TestWaterfallReadsAnImageTable();
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+    std::puts("descriptor selection tests passed");
+    return 0;
+}
