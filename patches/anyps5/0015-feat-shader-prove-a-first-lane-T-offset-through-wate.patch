+namespace {
+
+class MaskProof {
+public:
+    explicit MaskProof(const IrResourcePlan& program) : m_program(program) {}
+
+    bool Implies(const IrValue* mask, const IrValue* condition, std::uint32_t depth) {
+        if (mask == nullptr || condition == nullptr) return false;
+        return Memo(mask->Resolve(), condition->Resolve(), Mode::Implies, 0u, depth, [&] { return ImpliesUncached(mask, condition, depth); });
+    }
+
+    bool Excludes(const IrValue* mask, const IrValue* condition, std::uint32_t depth) {
+        if (mask == nullptr || condition == nullptr) return false;
+        return Memo(mask->Resolve(), condition->Resolve(), Mode::Excludes, 0u, depth, [&] { return ExcludesUncached(mask, condition, depth); });
+    }
+
+private:
+    bool ImpliesUncached(const IrValue* mask, const IrValue* condition, std::uint32_t depth) {
+        if (!Step()) return false;
+        mask = mask->Resolve();
+        condition = condition->Resolve();
+        if (const auto known = KnownBool(condition); known.has_value()) return *known || KnownBool(mask) == std::optional<bool>(false);
+        if (mask == condition || EquivalentValue(m_program, mask, condition)) return true;
+        if (Binary(condition, IrOpcode::LogicalAnd)) return Implies(mask, condition->Argument(0), depth) && Implies(mask, condition->Argument(1), depth);
+        if (Binary(condition, IrOpcode::LogicalOr) && (Implies(mask, condition->Argument(0), depth) || Implies(mask, condition->Argument(1), depth))) return true;
+        if (condition->Opcode() == IrOpcode::LogicalNot && condition->ArgumentCount() == 1u) return Excludes(mask, condition->Argument(0), depth);
+        if (const IrValue* arm = KnownArm(condition); arm != nullptr) return Implies(mask, arm, depth);
+        if (Select(condition) && Implies(mask, condition->Argument(1), depth) && Implies(mask, condition->Argument(2), depth)) return true;
+        if (ConditionLaneBit(mask, condition, depth, true)) return true;
+        return MaskSide(mask, condition, depth, Mode::Implies);
+    }
+
+    bool ExcludesUncached(const IrValue* mask, const IrValue* condition, std::uint32_t depth) {
+        if (!Step()) return false;
+        mask = mask->Resolve();
+        condition = condition->Resolve();
+        if (const auto known = KnownBool(condition); known.has_value()) return !*known || KnownBool(mask) == std::optional<bool>(false);
+        if (condition->Opcode() == IrOpcode::LogicalNot && condition->ArgumentCount() == 1u) return Implies(mask, condition->Argument(0), depth);
+        if (Binary(condition, IrOpcode::LogicalOr)) return Excludes(mask, condition->Argument(0), depth) && Excludes(mask, condition->Argument(1), depth);
+        if (Binary(condition, IrOpcode::LogicalAnd) && (Excludes(mask, condition->Argument(0), depth) || Excludes(mask, condition->Argument(1), depth))) return true;
+        if (const IrValue* arm = KnownArm(condition); arm != nullptr) return Excludes(mask, arm, depth);
+        if (Select(condition) && Excludes(mask, condition->Argument(1), depth) && Excludes(mask, condition->Argument(2), depth)) return true;
+        if (ConditionLaneBit(mask, condition, depth, false)) return true;
+        if (mask->Opcode() == IrOpcode::LogicalNot && mask->ArgumentCount() == 1u && Implies(condition, mask->Argument(0), depth)) return true;
+        return MaskSide(mask, condition, depth, Mode::Excludes);
+    }
+
+    enum class Mode : std::uint8_t { Implies, Excludes, BitImplies, BitExcludes, BitSet, BitClear };
+
+    struct Assumption {
+        const IrValue* node = nullptr;
+        const IrValue* target = nullptr;
+        Mode mode = Mode::Implies;
+        std::uint32_t component = 0;
+        bool invariant = false;
+        bool checked = false;
+    };
+
+    struct MemoKey {
+        const IrValue* first = nullptr;
+        const IrValue* second = nullptr;
+        Mode mode = Mode::Implies;
+        std::uint32_t component = 0;
+        std::uint32_t depth = 0;
+        bool operator==(const MemoKey&) const = default;
+    };
+
+    struct MemoHash {
+        std::size_t operator()(const MemoKey& key) const {
+            std::size_t hash = std::hash<const void*>{}(key.first);
+            hash = hash * 31u + std::hash<const void*>{}(key.second);
+            return hash * 31u + (static_cast<std::size_t>(key.mode) << 16u | key.component << 8u | key.depth);
+        }
+    };
+
+    static constexpr std::uint32_t stepBudget = 1u << 20;
+
+    template<typename Compute>
+    bool Memo(const IrValue* first, const IrValue* second, Mode mode, std::uint32_t component, std::uint32_t depth, Compute compute) {
+        const MemoKey key{first, second, mode, component, depth};
+        if (const auto found = m_memo.find(key); found != m_memo.end()) return found->second;
+        const auto hitsBefore = m_assumptionHits;
+        const bool result = compute();
+        if (m_steps <= stepBudget && (!result || m_assumptionHits == hitsBefore)) m_memo.emplace(key, result);
+        return result;
+    }
+
+    bool Step() {
+        return ++m_steps <= stepBudget;
+    }
+
+    static bool Binary(const IrValue* value, IrOpcode opcode) {
+        return value->Opcode() == opcode && value->ArgumentCount() == 2u;
+    }
+
+    static bool Select(const IrValue* value) {
+        return value->Opcode() == IrOpcode::SelectU1 && value->ArgumentCount() == 3u;
+    }
+
+    static std::optional<bool> KnownBool(const IrValue* value, std::uint32_t depth = 8u) {
+        value = value->Resolve();
+        if (value->HasImmediate() && value->Type() == IrType::Bool) return value->ImmediateU32() != 0u;
+        if (!value->IsPhi() || value->ArgumentCount() == 0u || depth == 0u) return std::nullopt;
+        std::optional<bool> known;
+        for (std::size_t index = 0; index < value->ArgumentCount(); ++index) {
+            const IrValue* incoming = value->Argument(index)->Resolve();
+            if (incoming == value) continue;
+            const auto bit = KnownBool(incoming, depth - 1u);
+            if (!bit.has_value() || (known.has_value() && *known != *bit)) return std::nullopt;
+            known = bit;
+        }
+        return known;
+    }
+
+    static const IrValue* KnownArm(const IrValue* value) {
+        if (!Select(value)) return nullptr;
+        const auto known = KnownBool(value->Argument(0));
+        if (!known.has_value()) return nullptr;
+        return value->Argument(*known ? 1u : 2u)->Resolve();
+    }
+
+    static bool IsImmediate(const IrValue* value, std::uint32_t immediate) {
+        value = value->Resolve();
+        return value->HasImmediate() && value->Type() == IrType::U32 && value->ImmediateU32() == immediate;
+    }
+
+    static const IrValue* OtherOperand(const IrValue* value, IrOpcode opcode, std::uint32_t immediate) {
+        if (!Binary(value, opcode)) return nullptr;
+        if (IsImmediate(value->Argument(1), immediate)) return value->Argument(0)->Resolve();
+        if (IsImmediate(value->Argument(0), immediate)) return value->Argument(1)->Resolve();
+        return nullptr;
+    }
+
+    static bool IsLaneId(const IrValue* value) {
+        return value != nullptr && value->Resolve()->Opcode() == IrOpcode::LaneId;
+    }
+
+    template<typename Proof>
+    bool Coinductive(const IrValue* node, const IrValue* target, Mode mode, std::uint32_t component, std::uint32_t depth, Proof proof) {
+        if (!node->IsPhi() || node->ArgumentCount() == 0u) return false;
+        const auto same = [&](const Assumption& entry) { return entry.node == node && entry.target == target && entry.mode == mode && entry.component == component; };
+        if (const auto found = std::ranges::find_if(m_assumed, same); found != m_assumed.end()) {
+            if (!found->checked) {
+                found->invariant = Invariant(target, node);
+                found->checked = true;
+            }
+            if (!found->invariant) return false;
+            ++m_assumptionHits;
+            return true;
+        }
+        if (depth == 0u) return false;
+        m_assumed.push_back({node, target, mode, component});
+        bool proved = true;
+        for (std::size_t index = 0; index < node->ArgumentCount() && proved; ++index) proved = proof(node->Argument(index), depth - 1u);
+        m_assumed.pop_back();
+        return proved;
+    }
+
+    bool Invariant(const IrValue* target, const IrValue* phi) {
+        const IrBlock* definition = target->Resolve()->Parent();
+        const IrBlock* header = phi->Parent();
+        if (definition == nullptr) return true;
+        if (header == nullptr || definition == header) return false;
+        const auto key = std::pair{definition, header};
+        if (const auto found = m_dominance.find(key); found != m_dominance.end()) return found->second;
+        std::vector<const IrBlock*> pending{header};
+        std::vector<const IrBlock*> visited{header};
+        bool dominates = true;
+        while (!pending.empty() && dominates) {
+            const IrBlock* block = pending.back();
+            pending.pop_back();
+            if (block->Predecessors().empty()) dominates = false;
+            for (const IrBlock* predecessor : block->Predecessors()) {
+                if (predecessor == definition || std::ranges::find(visited, predecessor) != visited.end()) continue;
+                visited.push_back(predecessor);
+                pending.push_back(predecessor);
+            }
+        }
+        m_dominance.emplace(key, dominates);
+        return dominates;
+    }
+
+    bool MaskSide(const IrValue* mask, const IrValue* condition, std::uint32_t depth, Mode mode) {
+        const auto recurse = [&](const IrValue* next, std::uint32_t nextDepth) { return mode == Mode::Implies ? Implies(next, condition, nextDepth) : Excludes(next, condition, nextDepth); };
+        if (Binary(mask, IrOpcode::LogicalAnd)) return recurse(mask->Argument(0), depth) || recurse(mask->Argument(1), depth);
+        if (const IrValue* arm = KnownArm(mask); arm != nullptr) return recurse(arm, depth);
+        if (Select(mask)) return recurse(mask->Argument(1), depth) && recurse(mask->Argument(2), depth);
+        if (mask->Opcode() == IrOpcode::INotEqual32) return OwnLaneBit(mask, condition, depth, mode == Mode::Implies);
+        return Coinductive(mask, condition, mode, 0u, depth, recurse);
+    }
+
+    static bool LaneWords(const IrValue* test, std::array<const IrValue*, 2>& words) {
+        const IrValue* bit = OtherOperand(test, IrOpcode::INotEqual32, 0u);
+        const IrValue* shifted = bit != nullptr ? OtherOperand(bit, IrOpcode::BitwiseAnd32, 1u) : nullptr;
+        if (shifted == nullptr || !Binary(shifted, IrOpcode::ShiftRightLogical32)) return false;
+        if (!IsLaneId(OtherOperand(shifted->Argument(1)->Resolve(), IrOpcode::BitwiseAnd32, 31u))) return false;
+        const IrValue* word = shifted->Argument(0)->Resolve();
+        words = {word, nullptr};
+        if (word->Opcode() == IrOpcode::SelectU32 && word->ArgumentCount() == 3u) {
+            const IrValue* half = word->Argument(0)->Resolve();
+            if (!Binary(half, IrOpcode::ULessThan32) || !IsLaneId(half->Argument(0)) || !IsImmediate(half->Argument(1), 32u)) return false;
+            words = {word->Argument(1)->Resolve(), word->Argument(2)->Resolve()};
+        }
+        return true;
+    }
+
+    bool OwnLaneBit(const IrValue* mask, const IrValue* condition, std::uint32_t depth, bool positive) {
+        std::array<const IrValue*, 2> words{};
+        if (!LaneWords(mask, words)) return false;
+        return LaneBit(words[0], 0u, condition, depth, positive) && (words[1] == nullptr || LaneBit(words[1], 1u, condition, depth, positive));
+    }
+
+    bool ConditionLaneBit(const IrValue* mask, const IrValue* condition, std::uint32_t depth, bool set) {
+        std::array<const IrValue*, 2> words{};
+        if (condition->Opcode() != IrOpcode::INotEqual32 || !LaneWords(condition, words)) return false;
+        return WordBit(mask, words[0], 0u, depth, set) && (words[1] == nullptr || WordBit(mask, words[1], 1u, depth, set));
+    }
+
+    const IrValue* BallotLanes(const IrValue* extract, std::uint32_t component) const {
+        extract = extract->Resolve();
+        if (extract->Opcode() != IrOpcode::CompositeExtractU32x4 || extract->ArgumentCount() != 2u || !IsImmediate(extract->Argument(1), component)) return nullptr;
+        const IrValue* ballot = extract->Argument(0)->Resolve();
+        return ballot->Opcode() == IrOpcode::Ballot && ballot->ArgumentCount() == 1u ? ballot->Argument(0)->Resolve() : nullptr;
+    }
+
+    bool WordBit(const IrValue* mask, const IrValue* word, std::uint32_t component, std::uint32_t depth, bool set) {
+        return Memo(mask->Resolve(), word->Resolve(), set ? Mode::BitSet : Mode::BitClear, component, depth, [&] { return WordBitUncached(mask->Resolve(), word->Resolve(), component, depth, set); });
+    }
+
+    bool WordBitUncached(const IrValue* mask, const IrValue* word, std::uint32_t component, std::uint32_t depth, bool set) {
+        if (!Step()) return false;
+        if (word->HasImmediate()) return word->Type() == IrType::U32 && word->ImmediateU32() == (set ? 0xffffffffu : 0u);
+        if (const IrValue* lanes = BallotLanes(word, component); lanes != nullptr) return set ? Implies(mask, lanes, depth) : Excludes(mask, lanes, depth);
+        if (word->Opcode() == IrOpcode::BitwiseNot32 && word->ArgumentCount() == 1u) return WordBit(mask, word->Argument(0), component, depth, !set);
+        if (Binary(word, IrOpcode::BitwiseAnd32)) {
