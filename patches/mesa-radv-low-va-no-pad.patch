@@ -587,6 +587,12 @@ radv_amdgpu_winsys_bo_create(struct radeon_winsys *_ws, uint64_t size, unsigned
 
    assert(!replay_address || (flags & RADEON_FLAG_REPLAYABLE));
 
+   /* rebox: no read-only page mapped after a lower-half replay address (a title's memory taken
+    * in place, see radv_amdgpu_va_range_flags): the title's memory goes on past it, and the next
+    * allocation taken in place has to start right there. */
+   if (radv_amdgpu_low_replay(replay_address, flags))
+      flags &= ~RADEON_FLAG_VM_PAD_1PAGE;
+
    const uint64_t va_size = radv_amdgpu_bo_va_size(size, flags);
    const uint64_t va_flags = radv_amdgpu_va_range_flags(replay_address, flags);
    uint64_t va_gap_size = ws->debug_vm ? MAX2(4 * virt_alignment, 64 * 1024) : 0;
