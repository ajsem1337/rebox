+/* rebox: 32-bit allocations (descriptor buffers, shader binaries)
+ * come from the low 4 GiB of GPU VA instead of the high 32-bit window, with
+ * address32_hi = 0 to match (radv_amdgpu_winsys.c). Console shaders build
+ * descriptor-table pointers from 32 bits with a zero high dword, as console
+ * descriptor heaps sit below 4 GiB. RADV_REBOX_LOW_32BIT=0 restores the
+ * high window. */
 static uint64_t
 radv_amdgpu_va_range_flags(uint64_t replay_address, enum radeon_bo_flag flags)
 {
-   const bool low = replay_address && replay_address < (1ull << 47) && !(flags & RADEON_FLAG_32BIT);
+   const bool low = ((flags & RADEON_FLAG_32BIT) && radv_amdgpu_rebox_low_32bit()) ||
+                    (replay_address && replay_address < (1ull << 47) && !(flags & RADEON_FLAG_32BIT));
 
    return (low ? 0 : AMDGPU_VA_RANGE_HIGH) | (flags & RADEON_FLAG_32BIT ? AMDGPU_VA_RANGE_32_BIT : 0) |
           (flags & RADEON_FLAG_REPLAYABLE ? AMDGPU_VA_RANGE_REPLAYABLE : 0);
