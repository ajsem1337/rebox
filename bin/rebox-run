#!/usr/bin/env bash
# Run a dumped Xbox Series (Scarlett) GDK title under WineGDK + vkd3d-proton,
# with the xmem/d3d12_xs shims and an AnyPS5 shader cache.
#
#   rebox-run [--scan] GAME_DIR [-- GAME_ARGS...]
#
# Environment (the flake wrapper sets the first five):
#   WINE                  wine binary (WineGDK build)
#   VKD3D_PROTON_DIR      directory holding vkd3d-proton's x64 d3d12.dll/d3d12core.dll
#   DXVK_DIR              directory holding DXVK's x64 dxgi.dll
#   REBOX_SHIMS_DIR    directory holding built xmem.dll/d3d12_xs.dll
#   REBOX_SCAN         scan_imports.py command (used by --scan)
#   WINEPREFIX            default: ~/.local/share/rebox/<TitleId>
#   REBOX_SHADER_CACHE Unix path to the AnyPS5 cache; default: $WINEPREFIX/shader-cache
#   REBOX_GPUVA_LAYER_DIR  directory holding VK_LAYER_REBOX_gpuva_identity's manifest (flake sets it)
#   XGR_*                 Gaming Runtime stand-in settings (shims/xgameruntime/README.md); XGR_PLS_DIR,
#                         XGR_LOG and GTX_LOG default to the prefix
#   REBOX_BCPACK=0     don't start the BCPack helper (helpers/bcpack); REBOX_BCPACK_HISTORY
#                         passes calibrated BC6H/BC7 history tables, REBOX_BCPACK_STRICT=1
#                         refuses chunks that need provisional ones
#   REBOX_CONSOLE_MODE ConsoleMode registry value the title reads (default 0x64, Series X)
#   REBOX_FFX_STUB=0   run the package's own FidelityFX loader instead of our stub
#   REBOX_RADV_ICD     ICD manifest of .#radv-rebox (flake sets it); used on AMD GPUs
#                         unless VK_ICD_FILENAMES is already set or REBOX_STOCK_VULKAN=1
#   REBOX_DUMP_SHADERS, REBOX_STUB_FATAL, REBOX_LOG: see README
set -euo pipefail

die() { echo "rebox-run: $*" >&2; exit 1; }

scan=0
if [[ ${1:-} == --scan ]]; then scan=1; shift; fi
[[ $# -ge 1 ]] || die "usage: rebox-run [--scan] GAME_DIR [-- GAME_ARGS...]"
game_dir=$(realpath "$1"); shift
[[ ${1:-} == -- ]] && shift

config="$game_dir/MicrosoftGame.Config"
[[ -f $config ]] || die "no MicrosoftGame.Config in $game_dir"

# First <Executable Name="..."> and the TitleId; good enough for MicrosoftGame.Config.
exe=$(grep -o '<Executable [^>]*' "$config" | head -1 | sed -n 's/.* Name="\([^"]*\)".*/\1/p')
title_id=$(sed -n 's:.*<TitleId>\([^<]*\)</TitleId>.*:\1:p' "$config" | head -1)
[[ -n $exe ]] || die "no <Executable> in $config"
title_id=${title_id:-unknown}

: "${WINE:?set WINE to a WineGDK wine binary (or use the flake wrapper)}"
: "${VKD3D_PROTON_DIR:?set VKD3D_PROTON_DIR}"
: "${DXVK_DIR:?set DXVK_DIR}"
: "${REBOX_SHIMS_DIR:?set REBOX_SHIMS_DIR}"
wine_dlls="$(dirname "$(realpath "$(command -v "$WINE")")")/../lib/wine/x86_64-windows"

if (( scan )); then
    exec ${REBOX_SCAN:-scan_imports.py} "$game_dir" \
        --provider "$REBOX_SHIMS_DIR" --provider "$VKD3D_PROTON_DIR" --provider "$wine_dlls"
fi

[[ -f $game_dir/$exe ]] || die "$exe is listed in MicrosoftGame.Config but missing from $game_dir (not dumped/decrypted yet?)"

export WINEPREFIX=${WINEPREFIX:-$HOME/.local/share/rebox/$title_id}
export WINEARCH=win64
if [[ ! -d $WINEPREFIX/drive_c ]]; then
    echo "rebox-run: creating prefix $WINEPREFIX" >&2
    mkdir -p "$WINEPREFIX"
    "$WINE" wineboot -i >/dev/null 2>&1 || die "wineboot failed for $WINEPREFIX"
fi

# Which console this is: the GDK's XSystemGetDeviceType is compiled into the title and reads
# ConsoleMode under this key (0x64 Series X, 0x50 Xbox One X). Without it the title is told it's
# on a PC, which a console build has no case for (XValkyrie, docs/d3d12x.md).
console_mode=$(printf '%08x' "$((${REBOX_CONSOLE_MODE:-0x64}))")
if ! grep -qi "\"ConsoleMode\"=dword:$console_mode" "$WINEPREFIX/system.reg" 2>/dev/null; then
    "$WINE" reg add 'HKLM\Software\Microsoft\Windows NT\CurrentVersion\OEM' /v ConsoleMode \
        /t REG_DWORD /d "0x$console_mode" /f >/dev/null 2>&1 || die "couldn't set ConsoleMode in $WINEPREFIX"
fi

# Imports nothing provides (the scan, as with --scan): stub them so the title still loads. A
# missing export of one of our shims needs that shim rebuilt, so when the scan finds gaps the
# shims are rebuilt in the prefix from REBOX_SRC (the flake sets it, with mingw and make on
# PATH) with its stubs, which log their first call and return E_NOTIMPL. The scan's report goes
# to $WINEPREFIX/imports.txt; the rebuild happens again only when the stubs change.
# REBOX_AUTO_STUBS=0 turns this off.
if [[ -n ${REBOX_SRC:-} && ${REBOX_AUTO_STUBS:-1} == 1 ]]; then
    gen="$WINEPREFIX/generated-stubs"
    rm -rf "$gen"
    "${REBOX_SCAN:-scan_imports.py}" "$game_dir" --provider "$REBOX_SHIMS_DIR" --provider "$VKD3D_PROTON_DIR" \
        --provider "$DXVK_DIR" --provider "$wine_dlls" --shims "$REBOX_SRC/shims" --gen-stubs "$gen" \
        > "$WINEPREFIX/imports.txt" 2>&1 || true  # exits 1 when it found gaps
    if [[ -d $gen/dlls ]] || grep -qs . "$gen"/*_stubs.def; then
        key=$( (echo "$REBOX_SRC"; cd "$gen" && find . -type f -print0 | sort -z | xargs -0 cat) | sha256sum | cut -d' ' -f1)
        rebuilt="$WINEPREFIX/shim-build"
        if [[ $(cat "$rebuilt/.key" 2>/dev/null) != "$key" ]]; then
            echo "rebox-run: stubbing imports nothing provides (see $WINEPREFIX/imports.txt); rebuilding the shims" >&2
            rm -rf "$rebuilt"
            cp -r "$REBOX_SRC" "$rebuilt"
            chmod -R u+w "$rebuilt"
            mkdir -p "$rebuilt/generated"
            cp -r "$gen"/. "$rebuilt/generated/"
            ( [[ -n ${REBOX_BUILD_ENV:-} ]] && . "$REBOX_BUILD_ENV"
              make -C "$rebuilt" -j"$(nproc)" shims ${REBOX_MAKE_FLAGS:-} ) > "$rebuilt/build.log" 2>&1 \
                || die "rebuilding the shims with stubs failed: $rebuilt/build.log"
            cp "$REBOX_SHIMS_DIR"/rebox_anyps5.dll "$rebuilt/build/" 2>/dev/null || true
            echo "$key" > "$rebuilt/.key"
        fi
        REBOX_SHIMS_DIR="$rebuilt/build"
        grep -E '^generated' "$WINEPREFIX/imports.txt" | sed 's/^/rebox-run: /' >&2
    fi
fi

# Copy rather than symlink so the prefix survives nix garbage collection.
sys32="$WINEPREFIX/drive_c/windows/system32"
install -m 644 "$VKD3D_PROTON_DIR"/d3d12.dll "$VKD3D_PROTON_DIR"/d3d12core.dll "$DXVK_DIR"/dxgi.dll "$sys32"/

# Our DLLs: the shims (xmem, d3d12_xs, xaudio2_9, ...) and generated stub
# DLLs for imports nobody provides (tools/scan_imports.py --gen-stubs).
# Those standing in for a DLL the package ships go into the shadow package
# directory below, since Wine searches the game directory before system32;
# the rest go into system32 with a native override.
#   amd_fidelityfx_loader_xbox.dll  FidelityFX stub (bilinear upscale); the
#                                   console's needs precompiled-ISA shaders.
#                                   REBOX_FFX_STUB=0 keeps the original.
shadow="$WINEPREFIX/package"
rm -rf "$shadow"
mkdir -p "$shadow"
for entry in "$game_dir"/* "$game_dir"/.[!.]*; do
    [[ -e $entry ]] && ln -s "$entry" "$shadow/"
done
overrides="d3d12,d3d12core,dxgi=n"
for dll in "$REBOX_SHIMS_DIR"/*.dll "$REBOX_SHIMS_DIR"/stub/*.dll; do
    [[ -f $dll ]] || continue
    name=$(basename "$dll")
    if [[ -e $shadow/$name ]]; then
        [[ $name == amd_fidelityfx_loader_xbox.dll && ${REBOX_FFX_STUB:-1} == 0 ]] && continue
        rm -f "$shadow/$name"
        install -m 644 "$dll" "$shadow/$name"
        echo "rebox-run: using our $name instead of the package's" >&2
    else
        install -m 644 "$dll" "$sys32/"
        overrides+=";${name%.dll}=n"
        [[ $dll == */stub/* ]] && echo "rebox-run: stub DLL $name (every export returns E_NOTIMPL)" >&2
    fi
done

# Mount the package as G: too, for titles that assume a package drive.
ln -sfn "$shadow" "$WINEPREFIX/dosdevices/g:"

cache=${REBOX_SHADER_CACHE:-$WINEPREFIX/shader-cache}
mkdir -p "$cache"
cache=$(realpath "$cache")
export REBOX_SHADER_CACHE="Z:${cache//\//\\}"

# The Gaming Runtime stand-in (shims/xgameruntime). Persistent local storage lives in the prefix:
# its default, next to the executable, is the shadow package directory, remade every run. Its
# logs name every interface and method a title asks for that it doesn't implement.
winpath() { local p; p=$(realpath -m "$1"); echo "Z:${p//\//\\}"; }
mkdir -p "$WINEPREFIX/persistent-local-storage"
export XGR_PLS_DIR=${XGR_PLS_DIR:-$(winpath "$WINEPREFIX/persistent-local-storage")\\}
export XGR_LOG=${XGR_LOG:-$(winpath "$WINEPREFIX/xgameruntime.log")}
export GTX_LOG=${GTX_LOG:-$(winpath "$WINEPREFIX/xgameruntime-tasks.log")}
if [[ ${REBOX_LOG:-} == /* ]]; then
    export REBOX_LOG="Z:${REBOX_LOG//\//\\}"
fi
if [[ ${REBOX_DUMP_FRAMES:-} == /* ]]; then
    mkdir -p "$REBOX_DUMP_FRAMES"
    export REBOX_DUMP_FRAMES="Z:${REBOX_DUMP_FRAMES//\//\\}"
fi

export WINEDLLOVERRIDES="$overrides${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"

# Unified memory (docs/d3d12x.md): GPU VA == CPU address needs the identity
# layer and, on AMD, a RADV that accepts lower-half device addresses. The
# layer passes allocations through on drivers that can't do it.
if [[ -n ${REBOX_GPUVA_LAYER_DIR:-} ]]; then
    export VK_ADD_LAYER_PATH="$REBOX_GPUVA_LAYER_DIR${VK_ADD_LAYER_PATH:+:$VK_ADD_LAYER_PATH}"
    export VK_INSTANCE_LAYERS="VK_LAYER_REBOX_gpuva_identity${VK_INSTANCE_LAYERS:+:$VK_INSTANCE_LAYERS}"
fi
if [[ -z ${VK_ICD_FILENAMES:-} && -n ${REBOX_RADV_ICD:-} && ${REBOX_STOCK_VULKAN:-0} != 1 ]] \
    && grep -qs 0x1002 /sys/class/drm/card*/device/vendor; then
    export VK_ICD_FILENAMES=$REBOX_RADV_ICD
    echo "rebox-run: using patched RADV ($REBOX_RADV_ICD)" >&2
fi

echo "rebox-run: $exe (title $title_id), prefix $WINEPREFIX, shader cache $cache" >&2
# BCPack textures (DirectStorage, shims/xcrdapi): Leonida's GPLv3 decoder can't share the
# title's process with AnyPS5 (GPL-2.0-only), so it runs as helpers/bcpack, a separate process
# the shim reaches over localhost. It exits when this process (Wine, after the exec) does.
if [[ ${REBOX_BCPACK:-1} != 0 && -n ${REBOX_BCPACK_SCRIPT:-} && -n ${LEONIDA_SRC:-} ]]; then
    portfile="$WINEPREFIX/bcpack-helper.port"
    rm -f "$portfile"
    helper_args=(--leonida "$LEONIDA_SRC" --port-file "$portfile" --watch-pid $$)
    [[ -n ${REBOX_BCPACK_HISTORY:-} ]] && helper_args+=(--history "$REBOX_BCPACK_HISTORY")
    [[ ${REBOX_BCPACK_STRICT:-0} == 1 ]] && helper_args+=(--strict)
    "${REBOX_BCPACK_PYTHON:-python3}" -I "$REBOX_BCPACK_SCRIPT" "${helper_args[@]}" \
        > "$WINEPREFIX/bcpack-helper.log" 2>&1 &
    for _ in $(seq 100); do [[ -s $portfile ]] && break; sleep 0.1; done
    if [[ -s $portfile ]]; then
        export REBOX_BCPACK_PORT=$(cat "$portfile")
    else
        echo "rebox-run: the BCPack helper didn't start ($WINEPREFIX/bcpack-helper.log); BCPack textures will be missing" >&2
    fi
fi

cd "$shadow"
exec "$WINE" "$shadow/$exe" "$@"
